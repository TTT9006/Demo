    {
      "start": 2096.48,
      "end": 2097.84,
      "text": "1"
    },
    {
      "start": 2097.84,
      "end": 2102.24,
      "text": "はっきり決まったら、教えてください。"
    },
    {
      "start": 2102.24,
      "end": 2103.52,
      "text": "2"
    },
    {
      "start": 2103.52,
      "end": 2109.28,
      "text": "良かったです。今からでも出席可能ですから。"
