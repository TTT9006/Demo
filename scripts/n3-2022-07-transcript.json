      "text": "2番"
    },
    {
      "start": 2052.69,
      "end": 2056.53,
      "text": "あ、課長、お出かけですか?"
    },
    {
      "start": 2056.53,
      "end": 2060.69,
      "text": "今にも雨が降り出しそうですよ。"
