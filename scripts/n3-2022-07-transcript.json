      "start": 2136.26,
      "end": 2137.62,
      "text": "1"
    },
    {
      "start": 2137.62,
      "end": 2140.82,
      "text": "やっと終わったね。"
    },
    {
      "start": 2140.82,
      "end": 2142.1,
      "text": "2"
    },
    {
      "start": 2142.1,
      "end": 2146.0,
      "text": "間に合うように頑張ろうね。"
