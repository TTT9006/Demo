      "start": 2280.78,
      "end": 2281.98,
      "text": "2"
    },
    {
      "start": 2281.98,
      "end": 2286.06,
      "text": "あ、好きじゃなかった?"
    },
    {
      "start": 2286.06,
      "end": 2287.34,
      "text": "3"
    },
    {
      "start": 2287.34,
      "end": 2301.39,
      "text": "え、どこかに忘れたの?"
