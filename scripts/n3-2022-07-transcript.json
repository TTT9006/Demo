      "start": 2318.16,
      "end": 2319.36,
      "text": "2"
    },
    {
      "start": 2319.44,
      "end": 2325.36,
      "text": "木村さん、パソコンのこと全然知らないよね。"
    },
    {
      "start": 2325.36,
      "end": 2326.64,
      "text": "3"
    },
    {
      "start": 2326.64,
