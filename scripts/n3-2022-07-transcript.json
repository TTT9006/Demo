      "start": 2174.08,
      "end": 2175.36,
      "text": "2"
    },
    {
      "start": 2175.36,
      "end": 2179.12,
      "text": "研究室には行ってみた?"
    },
    {
      "start": 2179.12,
      "end": 2180.48,
      "text": "3"
    },
    {
      "start": 2180.48,
      "end": 2195.42,
      "text": "そうなの?まずメールで約束したら?"
    },
    {
      "start": 2195.42,
      "end": 2197.1,
      "text": "6番"
    },
    {
      "start": 2197.1,
      "end": 2204.34,
      "text": "このコピーの機械、最近動かなくなることがあるんだよ。"
    },
    {
      "start": 2204.34,
      "end": 2205.62,
      "text": "1"
    },
    {
      "start": 2205.62,
      "end": 2209.9,
      "text": "もう全然動かないの?"
    },
    {
      "start": 2209.9,
      "end": 2211.18,
      "text": "2"
    },
    {
      "start": 2211.18,
      "end": 2214.38,
      "text": "ああ、直してもらったんだね。"
    },
    {
      "start": 2214.38,
      "end": 2217.06,
      "text": "3"
    },
    {
      "start": 2217.06,
      "end": 2231.58,
      "text": "修理、頼んだほうがいいね。"
    },
    {
      "start": 2231.58,
      "end": 2233.18,
      "text": "7番"
    },
    {
      "start": 2233.34,
      "end": 2236.94,
      "text": "明日、海に行くの楽しみだね。"
    },
    {
      "start": 2236.94,
      "end": 2240.83,
      "text": "道が込んでないといいね。"
    },
    {
      "start": 2240.83,
      "end": 2242.11,
      "text": "1"
    },
    {
      "start": 2242.11,
      "end": 2245.84,
      "text": "こまなくて良かったね。"
    },
    {
      "start": 2245.84,
      "end": 2247.04,
      "text": "2"
    },
    {
      "start": 2247.04,
      "end": 2250.86,
      "text": "こむのは嫌だよね。"
    },
    {
      "start": 2250.86,
      "end": 2252.06,
      "text": "3"
    },
    {
      "start": 2252.06,
      "end": 2266.14,
      "text": "え、明日は込んでないの?"
