{
  "source": "C:\\Users\\Hoang Vuong\\Desktop\\Tiếng nhật\\đề và nghe\\N3\\n3\\n3\\7-2022\\Nghe N3 T7-2022 (BẢN CHUẨN オリジナル).mp3",
  "duration": 2384.7455625,
  "segments": [
    {
      "start": 6.93,
      "end": 13.83,
      "text": "長海試験を始める前に、音を聞いてください。"
    },
    {
      "start": 13.83,
      "end": 20.46,
      "text": "まだ、問題用紙を開けないでください。"
    },
    {
      "start": 20.46,
      "end": 28.13,
      "text": "音がよく聞こえない時は、手を挙げてください。"
    },
    {
      "start": 28.13,
      "end": 40.73,
      "text": "天気がいいから散歩しましょう。"
    },
    {
      "start": 40.73,
      "end": 50.49,
      "text": "日本語能力試験、長海N3、これからN3の長海試験を始めます。"
    },
    {
      "start": 50.49,
      "end": 55.31,
      "text": "目も取ってもいいです。"
    },
    {
      "start": 55.31,
      "end": 58.07,
      "text": "問題用紙を開けてください。"
    },
    {
      "start": 58.07,
      "end": 63.91,
      "text": "問題用紙のページがない時は、手を挙げてください。"
    },
    {
      "start": 63.91,
      "end": 74.0,
      "text": "問題がよく見えない時も、手を挙げてください。"
    },
    {
      "start": 74.0,
      "end": 80.16,
      "text": "問題がよく見えない時も、手を挙げてください。"
    },
    {
      "start": 80.16,
      "end": 88.46,
      "text": "いつでもいいです。"
    },
    {
      "start": 88.46,
      "end": 90.86,
      "text": "問題1"
    },
    {
      "start": 90.86,
      "end": 97.86,
      "text": "問題1では、まず質問を聞いてください。"
    },
    {
      "start": 97.86,
      "end": 101.54,
      "text": "それから話を聞いて、"
    },
    {
      "start": 101.54,
      "end": 113.83,
      "text": "問題用紙の1から4の中から、最も良いものを一つ選んでください。"
    },
    {
      "start": 113.95,
      "end": 122.03,
      "text": "では、始めます。"
    },
    {
      "start": 122.03,
      "end": 123.55,
      "text": "問題1"
    },
    {
      "start": 123.55,
      "end": 128.99,
      "text": "会社で、男の人と女の人が話しています。"
    },
    {
      "start": 128.99,
      "end": 134.19,
      "text": "男の人は、まず何をしますか?"
    },
    {
      "start": 134.19,
      "end": 139.63,
      "text": "山口さん、倉庫の整理どう?進んでる? 手伝いに来たよ。"
    },
    {
      "start": 139.63,
      "end": 140.95,
      "text": "ありがとう。"
    },
    {
      "start": 140.95,
      "end": 145.35,
      "text": "何すればいい? ゴミ随分あるから捨ててこようか?"
    },
    {
      "start": 145.35,
      "end": 147.39,
      "text": "それは最後でいいよ。"
    },
    {
      "start": 147.39,
      "end": 153.75,
      "text": "それより古い資料の整理をお願いできる? 箱の中にたくさんあるんだけど。"
    },
    {
      "start": 153.75,
      "end": 155.23,
      "text": "あ、これだね。"
    },
    {
      "start": 155.23,
      "end": 158.91,
      "text": "うん。それ、棚に並べてほしいんだ。"
    },
    {
      "start": 158.91,
      "end": 161.99,
      "text": "あ、その前に棚を拭いてくれる?"
    },
    {
      "start": 161.99,
      "end": 163.19,
      "text": "わかった。"
    },
    {
      "start": 163.19,
      "end": 168.27,
      "text": "それから、後でコピー用紙事務所に運ぶのを手伝ってくれない?"
    },
    {
      "start": 168.27,
      "end": 174.69,
      "text": "いいよ。"
    },
    {
      "start": 174.69,
      "end": 193.98,
      "text": "男の人は、まず何をしますか?"
    },
    {
      "start": 193.98,
      "end": 195.5,
      "text": "2番"
    },
    {
      "start": 195.5,
      "end": 201.74,
      "text": "レストランで、男の店長と女の店員が話しています。"
    },
    {
      "start": 201.74,
      "end": 208.22,
      "text": "女の店員は、メニューにどんな情報を加えますか?"
    },
    {
      "start": 208.22,
      "end": 212.22,
      "text": "テーブルに置いているメニューを作り替えようと思ってるんだけど、"
    },
    {
      "start": 212.22,
      "end": 218.5,
      "text": "吉田さん、パソコンでそういうのを作るの、上手だったよね。お願いできる?"
    },
    {
      "start": 218.5,
      "end": 219.58,
      "text": "はい。"
    },
    {
      "start": 219.58,
      "end": 228.22,
      "text": "今は、料理の写真と名前と値段だけしか載せてないから、もう少し情報を加えたいと思ってるんだ。"
    },
    {
      "start": 228.22,
      "end": 234.58,
      "text": "ああ、料理の味とかカロリーとか、メニューに載ってるといいなと思ってました。"
    },
    {
      "start": 234.58,
      "end": 238.38,
      "text": "うーん。味の説明は難しいからね。"
    },
    {
      "start": 238.38,
      "end": 245.06,
      "text": "そうじゃなくて、アレルギーとか健康の問題で食べられないものがある人がいるでしょ?"
    },
    {
      "start": 245.06,
      "end": 254.18,
      "text": "だから、卵とかエビとか、何を使ってるか載せた方がいいと思うんだ。写真だけじゃよく分からないしね。"
    },
    {
      "start": 254.18,
      "end": 257.26,
      "text": "そうですね。分かりました。"
    },
    {
      "start": 257.26,
      "end": 270.83,
      "text": "後でメモを渡すよ。カロリーも載せたいけど、計算しないといけないからね。それはまたの機会にしよう。"
    },
    {
      "start": 270.83,
      "end": 290.72,
      "text": "女の店員は、メニューにどんな情報を加えますか?"
    },
    {
      "start": 290.72,
      "end": 292.32,
      "text": "3番。"
    },
    {
      "start": 292.32,
      "end": 300.6,
      "text": "駅の観光案内の事務所で、女の人と係の男の人が話しています。"
    },
    {
      "start": 300.6,
      "end": 306.47,
      "text": "女の人は、全部でいくらお金を払いますか?"
    },
    {
      "start": 306.47,
      "end": 311.83,
      "text": "すみません。こちらでスーツケースを預かってもらえるって聞いたんですけど。"
    },
    {
      "start": 311.83,
      "end": 316.63,
      "text": "ええ。一つ、1日500円で預かりますよ。"
    },
    {
      "start": 316.63,
      "end": 321.79,
      "text": "こちらは午後6時までですので、それまでにお戻りください。"
    },
    {
      "start": 321.79,
      "end": 325.55,
      "text": "2つお願いしたいので、1000円ですね。"
    },
    {
      "start": 325.55,
      "end": 329.27,
      "text": "でも、6時までに戻ってこられないかも。"
    },
    {
      "start": 329.27,
      "end": 333.35,
      "text": "あの、今日はどちらかにお泊まりになりました?"
    },
    {
      "start": 333.35,
      "end": 341.51,
      "text": "ええ。緑ホテルです。駅から少し遠いので、この辺で観光してからチェックインしようと思って。"
    },
    {
      "start": 341.51,
      "end": 347.07,
      "text": "それなら荷物をお泊まりになるホテルに配達するサービスもありますよ。"
    },
    {
      "start": 347.07,
      "end": 355.75,
      "text": "荷物をお預かりする料金のほかに配達量がかかりますが、配達量はいくつでも600円です。"
    },
    {
      "start": 355.75,
      "end": 361.83,
      "text": "じゃあ、ぜひお願いします。これで時間を気にしないでゆっくり観光できます。"
    },
    {
      "start": 361.83,
      "end": 364.95,
      "text": "ええ、ゆっくり楽しんでください。"
    },
    {
      "start": 364.95,
      "end": 375.08,
      "text": "それから、すみません。料金は先にお願いします。"
    },
    {
      "start": 375.08,
      "end": 394.82,
      "text": "女の人は、全部でいくらお金を払いますか?"
    },
    {
      "start": 394.82,
      "end": 396.46,
      "text": "4番。"
    },
    {
      "start": 396.46,
      "end": 404.18,
      "text": "大学の国際交流会で、大学の人が留学生に話しています。"
    },
    {
      "start": 404.18,
      "end": 410.14,
      "text": "留学生は、この後まず、何をしますか?"
    },
    {
      "start": 410.14,
      "end": 419.7,
      "text": "この前の交流会では、ビデオでこの街のお祭りの様子や、お祭りで踊っている様子を見ましたね。"
    },
    {
      "start": 419.7,
      "end": 423.62,
      "text": "今日は、踊りの先生をお呼びしました。"
    },
    {
      "start": 423.62,
      "end": 429.14,
      "text": "この街のお祭りで、よく踊る踊りを教えてもらいましょう。"
    },
    {
      "start": 429.14,
      "end": 434.98,
      "text": "浴衣を準備してありますから、あちらの部屋で着替えてきてください。"
    },
    {
      "start": 434.98,
      "end": 438.1,
      "text": "手伝ってくださる方たちがいらっしゃいます。"
    },
    {
      "start": 438.1,
      "end": 444.3,
      "text": "着替え終わったら、服やカバンはこの部屋の後ろにおいてください。"
    },
    {
      "start": 444.3,
      "end": 454.59,
      "text": "みんな準備ができたら、早速踊りの練習を始めましょう。"
    },
    {
      "start": 454.59,
      "end": 474.52,
      "text": "留学生は、この後まず、何をしますか?"
    },
    {
      "start": 474.52,
      "end": 476.08,
      "text": "5番。"
    },
    {
      "start": 476.08,
      "end": 481.36,
      "text": "会社で、女の人と男の人が話しています。"
    },
    {
      "start": 481.36,
      "end": 486.68,
      "text": "男の人は、何をしなければなりませんか?"
    },
    {
      "start": 486.68,
      "end": 488.24,
      "text": "田中さん。"
    },
    {
      "start": 488.24,
      "end": 493.84,
      "text": "この間話しましたけど、明日からいらっしゃる海外のお客様の通訳。"
    },
    {
      "start": 493.84,
      "end": 495.72,
      "text": "よろしくお願いしますね。"
    },
    {
      "start": 495.84,
      "end": 500.8,
      "text": "はい。空港に到着されるのは午前10時半でしたね。"
    },
    {
      "start": 500.8,
      "end": 504.2,
      "text": "ええ。お迎え、お願いしますね。"
    },
    {
      "start": 504.2,
      "end": 512.84,
      "text": "あさって、工場見学の予定が入っていますが、その時は工場の社員が通訳もしてくれることになりました。"
    },
    {
      "start": 512.84,
      "end": 520.0,
      "text": "田中さんは、この日はお客様の方は何もしなくてもいいので、いつもの仕事をしてください。"
    },
    {
      "start": 520.0,
      "end": 521.2,
      "text": "わかりました。"
    },
    {
      "start": 521.2,
      "end": 526.8,
      "text": "会議の通訳など、その他の予定は変わっていませんので、お願いします。"
    },
    {
      "start": 526.8,
      "end": 527.68,
      "text": "はい。"
    },
    {
      "start": 527.68,
      "end": 532.68,
      "text": "あ、お帰りになる時にお渡しするお土産、買わなくちゃ。"
    },
    {
      "start": 532.68,
      "end": 537.56,
      "text": "私、何か見てきましょうか。今日は夕方、時間があるので。"
    },
    {
      "start": 537.56,
      "end": 540.32,
      "text": "ありがとう。でも大丈夫。"
    },
    {
      "start": 540.32,
      "end": 550.09,
      "text": "この間、デパートに行った時、素敵なものを見つけましたから。"
    },
    {
      "start": 550.09,
      "end": 569.23,
      "text": "男の人は、何をしなければなりませんか?"
    },
    {
      "start": 569.23,
      "end": 570.87,
      "text": "6番。"
    },
    {
      "start": 570.87,
      "end": 576.95,
      "text": "大学で、男の学生と女の学生が話しています。"
    },
    {
      "start": 576.95,
      "end": 582.76,
      "text": "男の学生は、どの科目を選択しますか?"
    },
    {
      "start": 582.76,
      "end": 588.12,
      "text": "先輩、専門科目をあと一つ選ばなくちゃいけないんですけど、"
    },
    {
      "start": 588.12,
      "end": 594.52,
      "text": "産業の歴史とアジアの経済学とどっちにするか悩んでるんです。"
    },
    {
      "start": 594.52,
      "end": 600.52,
      "text": "産業の歴史は、毎週レポート出さなくちゃいけなくて大変だったよ。"
    },
    {
      "start": 600.52,
      "end": 602.2,
      "text": "勉強になったけどね。"
    },
    {
      "start": 602.2,
      "end": 611.0,
      "text": "え、毎週?内容は一番興味があるんですけど、あの、アジアの経済学は取りましたか?"
    },
    {
      "start": 611.0,
      "end": 619.84,
      "text": "うん。レポートはなかったけど、事業が進むのが早くて、ついていくのが本当に大変だった。"
    },
    {
      "start": 619.84,
      "end": 624.72,
      "text": "あ、貿易関係の仕事がしたいって言ってたよね。"
    },
    {
      "start": 624.72,
      "end": 628.76,
      "text": "国際関係学はどう?役に立つと思うけど。"
    },
    {
      "start": 628.76,
      "end": 631.56,
      "text": "あ、それ、去年取りました。"
    },
    {
      "start": 631.56,
      "end": 633.48,
      "text": "そうなんだ。"
    },
    {
      "start": 633.48,
      "end": 639.52,
      "text": "あとは、社会学研究もあるけど、あんまり興味ない?"
    },
    {
      "start": 639.52,
      "end": 641.28,
      "text": "そうですね。"
    },
    {
      "start": 641.28,
      "end": 646.28,
      "text": "じゃあやっぱり、一番興味があるの頑張ってみたら?"
    },
    {
      "start": 646.28,
      "end": 650.72,
      "text": "レポート大変かもしれないけど、勉強になると思うよ。"
    },
    {
      "start": 650.72,
      "end": 658.5,
      "text": "そうですね。そうします。"
    },
    {
      "start": 658.5,
      "end": 679.18,
      "text": "男の学生はどの科目を選択しますか?"
    },
    {
      "start": 679.18,
      "end": 681.5,
      "text": "問題2。"
    },
    {
      "start": 681.5,
      "end": 687.78,
      "text": "問題2では、まず質問を聞いてください。"
    },
    {
      "start": 687.78,
      "end": 693.22,
      "text": "その後、問題用紙を見てください。"
    },
    {
      "start": 693.22,
      "end": 700.22,
      "text": "読む時間があります。それから話を聞いて、"
    },
    {
      "start": 700.22,
      "end": 712.27,
      "text": "問題用紙の1から4の中から、最も良いものを一つ選んでください。"
    },
    {
      "start": 712.27,
      "end": 720.78,
      "text": "では、始めます。"
    },
    {
      "start": 720.78,
      "end": 722.38,
      "text": "一番。"
    },
    {
      "start": 722.38,
      "end": 729.18,
      "text": "大学で、女の留学生と男の留学生が話しています。"
    },
    {
      "start": 729.18,
      "end": 759.34,
      "text": "男の留学生は、どこで、どんな方法で調査をすると言っていますか?"
    },
    {
      "start": 759.34,
      "end": 763.58,
      "text": "ミンさん、卒業論文のテーマ、決めた?"
    },
    {
      "start": 763.58,
      "end": 770.7,
      "text": "うん。日本企業で働く外国人の仕事に対する考え方に興味があって、"
    },
    {
      "start": 770.82,
      "end": 773.22,
      "text": "それを調査しようと思ってるんだ。"
    },
    {
      "start": 773.22,
      "end": 775.26,
      "text": "面白そうだね。"
    },
    {
      "start": 775.26,
      "end": 778.1,
      "text": "じゃあ、アンケートとか取るの?"
    },
    {
      "start": 778.1,
      "end": 783.9,
      "text": "それも考えたんだけど、それよりインタビューでいろいろ聞くことにしたよ。"
    },
    {
      "start": 783.9,
      "end": 788.18,
      "text": "協力してくれる人とか、会社とか、見つかったの?"
    },
    {
      "start": 788.18,
      "end": 793.9,
      "text": "うん。自分の国にある日本の会社にいくつかお願いしてあるんだ。"
    },
    {
      "start": 793.9,
      "end": 796.94,
      "text": "夏休みに帰国するから、その時に。"
    },
    {
      "start": 796.94,
      "end": 799.5,
      "text": "え、日本じゃなくて?"
    },
    {
      "start": 799.5,
      "end": 803.5,
      "text": "日本にある会社については、結構調査されてるし、"
    },
    {
      "start": 803.5,
      "end": 813.47,
      "text": "海外の日本企業で働いている人の考え方を知りたくて。"
    },
    {
      "start": 813.47,
      "end": 835.3,
      "text": "男の留学生は、どこで、どんな方法で調査をすると言っていますか?"
    },
    {
      "start": 835.3,
      "end": 836.82,
      "text": "2番。"
    },
    {
      "start": 836.82,
      "end": 843.22,
      "text": "女の人と男の人が、ある温泉について話しています。"
    },
    {
      "start": 843.22,
      "end": 872.26,
      "text": "男の人は女の人に、何の情報をメールで送りますか?"
    },
    {
      "start": 872.26,
      "end": 876.42,
      "text": "来月、初めて光温泉に行くんです。"
    },
    {
      "start": 876.42,
      "end": 881.46,
      "text": "松本さんは光温泉、何度も言ってるんですよね。"
    },
    {
      "start": 881.46,
      "end": 885.1,
      "text": "どこかいいところあったら、教えてくれませんか?"
    },
    {
      "start": 885.1,
      "end": 891.3,
      "text": "ああ、藤旅館っていう景色がすごくいい旅館があるんですけど、"
    },
    {
      "start": 891.3,
      "end": 894.22,
      "text": "泊まるところ、もう予約しましたか?"
    },
    {
      "start": 894.22,
      "end": 897.54,
      "text": "あ、その旅館、調べたんですけど、"
    },
    {
      "start": 897.54,
      "end": 902.62,
      "text": "ちょっと高いと思って、もう別のところ予約してあるんです。"
    },
    {
      "start": 902.62,
      "end": 904.1,
      "text": "そうですか。"
    },
    {
      "start": 904.1,
      "end": 910.98,
      "text": "あとは、あのあたりはそばも有名ですし、新しくできた和菓子の店もありますよ。"
    },
    {
      "start": 910.98,
      "end": 915.58,
      "text": "甘いものは苦手ですけど、おそばはいいですね。"
    },
    {
      "start": 915.58,
      "end": 917.74,
      "text": "お昼はおそばにします。"
    },
    {
      "start": 917.74,
      "end": 921.22,
      "text": "じゃあ、美味しい店いくつか知ってるから、"
    },
    {
      "start": 921.22,
      "end": 924.18,
      "text": "後でメールで情報を送りますよ。"
    },
    {
      "start": 924.18,
      "end": 925.7,
      "text": "あとは…"
    },
    {
      "start": 925.7,
      "end": 931.42,
      "text": "うーん、いつも行く土産物屋、先月平転しちゃったんです。"
    },
    {
      "start": 931.42,
      "end": 933.98,
      "text": "種類が多くて良かったんですけど。"
    },
    {
      "start": 933.98,
      "end": 942.39,
      "text": "そうなんですか。残念。"
    },
    {
      "start": 942.39,
      "end": 963.15,
      "text": "男の人は女の人に、何の情報をメールで送りますか?"
    },
    {
      "start": 963.15,
      "end": 964.79,
      "text": "3番。"
    },
    {
      "start": 964.79,
      "end": 971.19,
      "text": "大学で、女の学生と男の学生が話しています。"
    },
    {
      "start": 971.31,
      "end": 1000.62,
      "text": "男の学生は、どうして熟のアルバイトをやめたと言っていますか?"
    },
    {
      "start": 1000.62,
      "end": 1006.02,
      "text": "西村君、熟の先生のアルバイトをやめたんだって?"
    },
    {
      "start": 1006.02,
      "end": 1009.46,
      "text": "面白いって言ってたのに、何かあったの?"
    },
    {
      "start": 1009.46,
      "end": 1015.22,
      "text": "うん。色々考えてね。時給は悪くなかったんだけど。"
    },
    {
      "start": 1015.22,
      "end": 1017.98,
      "text": "もっと良いアルバイト見つかったの?"
    },
    {
      "start": 1017.98,
      "end": 1020.38,
      "text": "いや、そうじゃないんだけど。"
    },
    {
      "start": 1020.38,
      "end": 1025.42,
      "text": "ゼミでレポートが多いし、他の授業も難しくなってきたから、"
    },
    {
      "start": 1025.42,
      "end": 1028.5,
      "text": "もっと勉強に時間を使いたいんだ。"
    },
    {
      "start": 1028.5,
      "end": 1032.18,
      "text": "授業の準備に時間が取られるからね。"
    },
    {
      "start": 1032.18,
      "end": 1033.78,
      "text": "そうか。"
    },
    {
      "start": 1033.78,
      "end": 1038.5,
      "text": "頑張って成績が上がったら、小学金がもらえるかもしれないし。"
    },
    {
      "start": 1038.5,
      "end": 1045.62,
      "text": "そうなるといいね。"
    },
    {
      "start": 1045.62,
      "end": 1066.7,
      "text": "男の学生は、どうして授業のアルバイトをやめたと言っていますか?"
    },
    {
      "start": 1066.7,
      "end": 1068.1,
      "text": "4番。"
    },
    {
      "start": 1068.26,
      "end": 1073.66,
      "text": "男の留学生と女の留学生が話しています。"
    },
    {
      "start": 1073.66,
      "end": 1103.29,
      "text": "女の留学生は、どうしてインターネットに日記を書き始めましたか?"
    },
    {
      "start": 1103.29,
      "end": 1108.73,
      "text": "リオさん、毎日インターネットに日記を書いてるんだって?"
    },
    {
      "start": 1108.73,
      "end": 1109.85,
      "text": "うん。"
    },
    {
      "start": 1109.85,
      "end": 1120.09,
      "text": "見たもの、食べたもの、言ったところなんか、毎日の生活を写真に撮って載せて、その説明を書いてる。"
    },
    {
      "start": 1120.21,
      "end": 1124.69,
      "text": "撮ったものを色んな人に見てほしくて始めたんだ。"
    },
    {
      "start": 1124.69,
      "end": 1127.37,
      "text": "日本に来る前からなんだけどね。"
    },
    {
      "start": 1127.37,
      "end": 1129.13,
      "text": "そうなんだ。"
    },
    {
      "start": 1129.13,
      "end": 1136.29,
      "text": "日本に来てからは、国の家族や友人も見てくれるようになって、喜んでるみたい。"
    },
    {
      "start": 1136.29,
      "end": 1139.09,
      "text": "どうしてるか、心配してたみたいで。"
    },
    {
      "start": 1139.09,
      "end": 1140.77,
      "text": "そっか。"
    },
    {
      "start": 1140.77,
      "end": 1156.26,
      "text": "最近、日本語で書くこともあるんだけど、読んだ人から日本語でメッセージをもらったりして交流するのが楽しいんだ。"
    },
    {
      "start": 1156.26,
      "end": 1177.82,
      "text": "女の留学生は、どうしてインターネットに日記を書き始めましたか?"
    },
    {
      "start": 1177.82,
      "end": 1179.38,
      "text": "5番。"
    },
    {
      "start": 1179.38,
      "end": 1184.54,
      "text": "社長が会議で商品について話しています。"
    },
    {
      "start": 1184.54,
      "end": 1212.52,
      "text": "社長はこの商品をどう買えると言っていますか?"
    },
    {
      "start": 1212.52,
      "end": 1217.56,
      "text": "去年の春に出したバッグは、人気商品になりました。"
    },
    {
      "start": 1217.56,
      "end": 1221.72,
      "text": "若者が好きそうな、明るい色やデザイン。"
    },
    {
      "start": 1221.72,
      "end": 1225.28,
      "text": "買いやすい値段にしたのが良かったのでしょう。"
    },
    {
      "start": 1225.28,
      "end": 1236.16,
      "text": "しかし、買った人に行った調査では、価格とサイズは良いが、少し重いと感じている人が多いことが分かりました。"
    },
    {
      "start": 1236.16,
      "end": 1245.08,
      "text": "今後は、今の色やサイズはそのままで、材料をもう少し軽いものにしたいと思います。"
    },
    {
      "start": 1245.08,
      "end": 1255.4,
      "text": "価格をあげずにどうするか、工夫が必要です。"
    },
    {
      "start": 1255.4,
      "end": 1275.3,
      "text": "社長はこの商品をどう買えると言っていますか?"
    },
    {
      "start": 1275.3,
      "end": 1276.94,
      "text": "6番。"
    },
    {
      "start": 1276.94,
      "end": 1281.86,
      "text": "留学説明会で先生が話しています。"
    },
    {
      "start": 1281.86,
      "end": 1310.98,
      "text": "先生は、留学して一番良かったことは何だと言っていますか?"
    },
    {
      "start": 1310.98,
      "end": 1320.38,
      "text": "私も学生時代、留学した経験がありますが、留学していろいろ学ぶことができました。"
    },
    {
      "start": 1320.38,
      "end": 1335.06,
      "text": "その国で生活することで、言葉が話せるようになるだけでなく、その国の文化がよくわかりましたし、自分の国についても初めて気付くことがありました。"
    },
    {
      "start": 1335.06,
      "end": 1341.1,
      "text": "留学した時には、ぜひそこで友人を作ってください。"
    },
    {
      "start": 1341.1,
      "end": 1350.74,
      "text": "私は、言葉や文化など国の違いを超えて、何でも話せる友人を作ることができました。"
    },
    {
      "start": 1350.74,
      "end": 1361.62,
      "text": "それが、留学して、最も意味があったことだと思います。"
    },
    {
      "start": 1361.62,
      "end": 1379.85,
      "text": "先生は、留学して一番良かったことは何だと言っていますか?"
    },
    {
      "start": 1379.85,
      "end": 1415.58,
      "text": "ここで、ちょっと休みましょう。"
    },
    {
      "start": 1415.58,
      "end": 1424.42,
      "text": "では、また続けます。"
    },
    {
      "start": 1424.42,
      "end": 1426.58,
      "text": "問題3"
    },
    {
      "start": 1426.58,
      "end": 1434.65,
      "text": "問題3では、問題用紙に何も印刷されていません。"
    },
    {
      "start": 1434.65,
      "end": 1443.34,
      "text": "この問題は、全体としてどんな内容かを聞く問題です。"
    },
    {
      "start": 1443.34,
      "end": 1448.46,
      "text": "話の前に、質問はありません。"
    },
    {
      "start": 1448.46,
      "end": 1452.82,
      "text": "まず、話を聞いてください。"
    },
    {
      "start": 1452.82,
      "end": 1468.7,
      "text": "それから、質問と選択肢を聞いて、1から4の中から、最も良いものを一つ選んでください。"
    },
    {
      "start": 1468.7,
      "end": 1477.18,
      "text": "では、始めます。"
    },
    {
      "start": 1477.18,
      "end": 1478.74,
      "text": "1番"
    },
    {
      "start": 1478.74,
      "end": 1484.98,
      "text": "会社で、女の人が侵入者員と話しています。"
    },
    {
      "start": 1484.98,
      "end": 1490.34,
      "text": "松本さん。会社に入って半年だけど、どう?"
    },
    {
      "start": 1490.34,
      "end": 1497.34,
      "text": "一生懸命やってるんですが、わからないことが多くて、最近疲れてしまって。"
    },
    {
      "start": 1497.34,
      "end": 1505.7,
      "text": "自分で過去の資料を調べて、書類作ってみたりしてるんですが、間違ってて、結局やり直すことになるんです。"
    },
    {
      "start": 1505.7,
      "end": 1510.46,
      "text": "松本さんは、何でも一人でやろうとしすぎるんじゃない?"
    },
    {
      "start": 1510.58,
      "end": 1516.38,
      "text": "質問したいことがあっても、皆さん忙しそうで話しかけにくくて。"
    },
    {
      "start": 1516.38,
      "end": 1522.42,
      "text": "私は、会社に入ってすぐの頃は、人に質問ばかりしてたよ。"
    },
    {
      "start": 1522.42,
      "end": 1526.54,
      "text": "みんな最初はそうなんだから、わかってくれると思うけど。"
    },
    {
      "start": 1526.54,
      "end": 1528.26,
      "text": "そうですか。"
    },
    {
      "start": 1528.26,
      "end": 1534.26,
      "text": "人に頼ることは悪いことじゃないんだから。私にも遠慮しないでね。"
    },
    {
      "start": 1534.26,
      "end": 1541.27,
      "text": "ありがとうございます。"
    },
    {
      "start": 1541.27,
      "end": 1545.67,
      "text": "女の人が伝えたいことは何ですか?"
    },
    {
      "start": 1546.11,
      "end": 1547.43,
      "text": "1"
    },
    {
      "start": 1547.43,
      "end": 1552.84,
      "text": "疲れた時は休んだほうがいい。"
    },
    {
      "start": 1552.84,
      "end": 1554.16,
      "text": "2"
    },
    {
      "start": 1554.16,
      "end": 1559.55,
      "text": "過去の資料を調べたほうがいい。"
    },
    {
      "start": 1559.55,
      "end": 1560.95,
      "text": "3"
    },
    {
      "start": 1560.95,
      "end": 1566.24,
      "text": "何でも自分でやったほうがいい。"
    },
    {
      "start": 1566.24,
      "end": 1567.6,
      "text": "4"
    },
    {
      "start": 1567.6,
      "end": 1581.66,
      "text": "わからないことは聞いたほうがいい。"
    },
    {
      "start": 1581.66,
      "end": 1583.18,
      "text": "2番"
    },
    {
      "start": 1583.18,
      "end": 1587.98,
      "text": "ラジオでアナウンサーが話しています。"
    },
    {
      "start": 1587.98,
      "end": 1593.42,
      "text": "キッチンか。つまりキッチンがついている車ですが、"
    },
    {
      "start": 1593.42,
      "end": 1601.34,
      "text": "これを利用して車の中で料理をして売る持ち帰り専門の店が増えています。"
    },
    {
      "start": 1601.34,
      "end": 1608.02,
      "text": "実際にキッチンカーでカレーの店を経営している男性に話を聞くと、"
    },
    {
      "start": 1608.02,
      "end": 1616.1,
      "text": "複数の場所に移動してお客さんを増やせる点に可能性を感じたと言っていました。"
    },
    {
      "start": 1616.1,
      "end": 1622.14,
      "text": "また、キッチンカーでカフェを経営している女性に話を聞くと、"
    },
    {
      "start": 1622.14,
      "end": 1630.66,
      "text": "キッチンカー一台あれば店が開けるので、お金があまりかからないのがいい点だと話してくれました。"
    },
    {
      "start": 1630.66,
      "end": 1641.34,
      "text": "このような形で店を出す人が、これからも増えていきそうですね。"
    },
    {
      "start": 1641.34,
      "end": 1646.82,
      "text": "アナウンサーは何について話していますか?"
    },
    {
      "start": 1646.82,
      "end": 1648.18,
      "text": "1"
    },
    {
      "start": 1648.18,
      "end": 1653.92,
      "text": "キッチンカーの店に来る客のタイプ"
    },
    {
      "start": 1653.92,
      "end": 1655.2,
      "text": "2"
    },
    {
      "start": 1655.2,
      "end": 1660.67,
      "text": "キッチンカーの店で人気の料理"
    },
    {
      "start": 1660.67,
      "end": 1662.03,
      "text": "3"
    },
    {
      "start": 1662.03,
      "end": 1668.0,
      "text": "キッチンカーで店を開くことのいい点"
    },
    {
      "start": 1668.0,
      "end": 1669.36,
      "text": "4"
    },
    {
      "start": 1669.36,
      "end": 1683.76,
      "text": "キッチンカーで店を開く方法"
    },
    {
      "start": 1683.76,
      "end": 1685.36,
      "text": "3番"
    },
    {
      "start": 1685.36,
      "end": 1690.25,
      "text": "テレビで女の人が話しています。"
    },
    {
      "start": 1690.25,
      "end": 1692.05,
      "text": "秋ですね。"
    },
    {
      "start": 1692.05,
      "end": 1697.73,
      "text": "秋の果物といえば、やっぱり柿をイメージしますね。"
    },
    {
      "start": 1697.73,
      "end": 1704.69,
      "text": "柿は日本では、リンゴや未冠に比べると消費量が少ないですが、"
    },
    {
      "start": 1704.69,
      "end": 1711.05,
      "text": "風を引きにくくすると言われるビタミンが、未冠の2倍もあるんです。"
    },
    {
      "start": 1711.05,
      "end": 1717.01,
      "text": "また、2日よりや血圧の高い人にも良いそうです。"
    },
    {
      "start": 1717.01,
      "end": 1723.57,
      "text": "昔から、柿を食べれば医者は要らない、という言葉もあります。"
    },
    {
      "start": 1723.57,
      "end": 1733.26,
      "text": "美味しい柿を食べて、元気に過ごしたいですね。"
    },
    {
      "start": 1733.26,
      "end": 1738.7,
      "text": "女の人は何について話していますか?"
    },
    {
      "start": 1738.7,
      "end": 1740.06,
      "text": "1"
    },
    {
      "start": 1740.06,
      "end": 1744.75,
      "text": "柿のイメージの変化"
    },
    {
      "start": 1744.75,
      "end": 1746.03,
      "text": "2"
    },
    {
      "start": 1746.03,
      "end": 1751.58,
      "text": "柿の消費量が少ない理由"
    },
    {
      "start": 1751.58,
      "end": 1752.94,
      "text": "3"
    },
    {
      "start": 1752.94,
      "end": 1758.27,
      "text": "柿の栄養とその効果"
    },
    {
      "start": 1758.27,
      "end": 1759.55,
      "text": "4"
    },
    {
      "start": 1759.55,
      "end": 1774.0,
      "text": "柿の美味しい食べ方"
    },
    {
      "start": 1774.0,
      "end": 1776.4,
      "text": "問題4"
    },
    {
      "start": 1776.48,
      "end": 1783.2,
      "text": "問題4では、絵を見ながら質問を聞いてください。"
    },
    {
      "start": 1783.2,
      "end": 1788.43,
      "text": "矢印の人は何と言いますか?"
    },
    {
      "start": 1788.43,
      "end": 1798.58,
      "text": "1から3の中から、最も良いものを1つ選んでください。"
    },
    {
      "start": 1798.58,
      "end": 1806.9,
      "text": "では、始めます。"
    },
    {
      "start": 1806.9,
      "end": 1808.5,
      "text": "1"
    },
    {
      "start": 1808.5,
      "end": 1813.54,
      "text": "レストランでスプーンが使いたいですが、ありません。"
    },
    {
      "start": 1813.54,
      "end": 1817.38,
      "text": "定員に何と言いますか?"
    },
    {
      "start": 1817.38,
      "end": 1818.74,
      "text": "1"
    },
    {
      "start": 1818.74,
      "end": 1823.54,
      "text": "あのスプーン、いただけますか?"
    },
    {
      "start": 1823.54,
      "end": 1824.82,
      "text": "2"
    },
    {
      "start": 1824.82,
      "end": 1829.78,
      "text": "あのスプーン、お使いください。"
    },
    {
      "start": 1829.78,
      "end": 1831.06,
      "text": "3"
    },
    {
      "start": 1831.06,
      "end": 1847.57,
      "text": "あのスプーン、いりません。"
    },
    {
      "start": 1847.57,
      "end": 1849.09,
      "text": "2番"
    },
    {
      "start": 1849.09,
      "end": 1853.65,
      "text": "店で、友達がTシャツを探しています。"
    },
    {
      "start": 1853.73,
      "end": 1857.97,
      "text": "友達に良さそうなTシャツを見つけました。"
    },
    {
      "start": 1857.97,
      "end": 1861.09,
      "text": "何と言いますか?"
    },
    {
      "start": 1861.09,
      "end": 1862.45,
      "text": "1"
    },
    {
      "start": 1862.45,
      "end": 1866.21,
      "text": "これ、来てみていい?"
    },
    {
      "start": 1866.21,
      "end": 1867.41,
      "text": "2"
    },
    {
      "start": 1867.41,
      "end": 1871.52,
      "text": "これ、買うのやめたら?"
    },
    {
      "start": 1871.52,
      "end": 1872.8,
      "text": "3"
    },
    {
      "start": 1872.8,
      "end": 1888.22,
      "text": "これ、いいんじゃない?"
    },
    {
      "start": 1888.22,
      "end": 1889.82,
      "text": "3番"
    },
    {
      "start": 1889.82,
      "end": 1893.02,
      "text": "テストを返してもらいました。"
    },
    {
      "start": 1893.02,
      "end": 1897.82,
      "text": "先生の点数の計算に間違いがありました。"
    },
    {
      "start": 1897.82,
      "end": 1900.86,
      "text": "何と言いますか?"
    },
    {
      "start": 1900.86,
      "end": 1902.22,
      "text": "1"
    },
    {
      "start": 1902.22,
      "end": 1907.82,
      "text": "あの、間違っているところを教えてください。"
    },
    {
      "start": 1907.82,
      "end": 1909.02,
      "text": "2"
    },
    {
      "start": 1909.02,
      "end": 1915.34,
      "text": "あの、点数の計算、もうやり直しません。"
    },
    {
      "start": 1915.34,
      "end": 1916.62,
      "text": "3"
    },
    {
      "start": 1916.62,
      "end": 1935.07,
      "text": "あの、点数の合計があっていないと思うんですけど。"
    },
    {
      "start": 1935.07,
      "end": 1936.67,
      "text": "4番"
    },
    {
      "start": 1936.75,
      "end": 1942.43,
      "text": "来月、はじめの1週間、休みをとりたいです。"
    },
    {
      "start": 1942.43,
      "end": 1946.27,
      "text": "課長に何と言いますか?"
    },
    {
      "start": 1946.27,
      "end": 1947.55,
      "text": "1"
    },
    {
      "start": 1947.55,
      "end": 1953.55,
      "text": "来月、はじめの1週間、休んでもらえませんか?"
    },
    {
      "start": 1953.55,
      "end": 1954.75,
      "text": "2"
    },
    {
      "start": 1954.75,
      "end": 1961.06,
      "text": "来月、はじめの1週間、休ませていただけませんか?"
    },
    {
      "start": 1961.06,
      "end": 1962.34,
      "text": "3"
    },
    {
      "start": 1962.34,
      "end": 1980.83,
      "text": "来月、はじめの1週間、休みをあげてください。"
    },
    {
      "start": 1980.83,
      "end": 1982.99,
      "text": "5"
    },
    {
      "start": 1982.99,
      "end": 1990.91,
      "text": "問題後では、問題用紙に何も印刷されていません。"
    },
    {
      "start": 1990.91,
      "end": 1995.5,
      "text": "まず、文を聞いてください。"
    },
    {
      "start": 1995.5,
      "end": 2009.65,
      "text": "それから、その返事を聞いて、1から3の中から、最も良いものを1つ選んでください。"
    },
    {
      "start": 2009.65,
      "end": 2018.21,
      "text": "では、はじめます。"
    },
    {
      "start": 2018.21,
      "end": 2019.81,
      "text": "1番"
    },
    {
      "start": 2019.81,
      "end": 2025.46,
      "text": "お客様、お茶のおかわり、いかがですか?"
    },
    {
      "start": 2025.46,
      "end": 2026.74,
      "text": "1"
    },
    {
      "start": 2026.74,
      "end": 2030.86,
      "text": "いえ、もう結構です。"
