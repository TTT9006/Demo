{
  "source": "C:\\Users\\Hoang Vuong\\Desktop\\Tiếng nhật\\đề và nghe\\N2\\ĐỀ JLPT N2\\ĐỀ JLPT N2\\Đề 3\\Nghe N2 T7-2022 BẢN CHUẨN YUUKIBUI.mp3",
  "duration": 2617.7316875,
  "segments": [
    {
      "start": 7.89,
      "end": 17.87,
      "text": "これから、音を聞いてください。音がよく聞こえない時は、手をあげてください。"
    },
    {
      "start": 17.87,
      "end": 30.41,
      "text": "天気がいいから散歩しましょう。"
    },
    {
      "start": 30.41,
      "end": 42.56,
      "text": "問題用紙に、目も取っても構いません。"
    },
    {
      "start": 42.56,
      "end": 46.26,
      "text": "問題用紙を開けてください。"
    },
    {
      "start": 46.46,
      "end": 51.76,
      "text": "問題用紙のページがない時は、手をあげてください。"
    },
    {
      "start": 51.76,
      "end": 56.42,
      "text": "問題がよく見えない時も、手をあげてください。"
    },
    {
      "start": 56.42,
      "end": 64.84,
      "text": "いつでもいいです。"
    },
    {
      "start": 64.84,
      "end": 66.82,
      "text": "問題1"
    },
    {
      "start": 66.82,
      "end": 72.02,
      "text": "問題1では、まず質問を聞いてください。"
    },
    {
      "start": 72.02,
      "end": 83.45,
      "text": "それから話を聞いて、問題用紙の1から4の中から、最も良いものを一つ選んでください。"
    },
    {
      "start": 83.45,
      "end": 91.61,
      "text": "では、始めます。"
    },
    {
      "start": 91.61,
      "end": 93.81,
      "text": "1番"
    },
    {
      "start": 93.81,
      "end": 98.61,
      "text": "日本語の授業で、先生が学生に話しています。"
    },
    {
      "start": 98.61,
      "end": 103.91,
      "text": "学生は、今日の授業で何をしますか?"
    },
    {
      "start": 103.91,
      "end": 109.41,
      "text": "この授業では、学期末にまとめとして、レポートを書いてもらいますが、"
    },
    {
      "start": 109.41,
      "end": 114.41,
      "text": "先週は、そのテーマを、私たちの町に決めましたね。"
    },
    {
      "start": 114.41,
      "end": 123.91,
      "text": "次回の授業では、この町に長く住んでいる商店街の方から、昔と今、どう変わったかなど、いろいろ話を聞いて、"
    },
    {
      "start": 123.91,
      "end": 127.71,
      "text": "その内容についてクラスで話し合います。"
    },
    {
      "start": 127.71,
      "end": 135.51,
      "text": "そのために、今回の授業は、町の歴史などを各自図書館に行って詳しく調べてみましょう。"
    },
    {
      "start": 135.51,
      "end": 142.49,
      "text": "しっかりやりましょう。"
    },
    {
      "start": 142.49,
      "end": 161.6,
      "text": "学生は、今日の授業で何をしますか?"
    },
    {
      "start": 161.6,
      "end": 163.1,
      "text": "2番"
    },
    {
      "start": 163.1,
      "end": 167.6,
      "text": "会社で、女の人と男の人が話しています。"
    },
    {
      "start": 167.6,
      "end": 175.57,
      "text": "男の人は、これからまず、何をしなければなりませんか?"
    },
    {
      "start": 175.57,
      "end": 183.77,
      "text": "山下さん、前回の会社説明会の参加者アンケートなんだけど、結果をまとめる作業は終わった?"
    },
    {
      "start": 183.77,
      "end": 187.97,
      "text": "明日の会議で報告するんで、教授に見ときたいんだけど。"
    },
    {
      "start": 187.97,
      "end": 189.97,
      "text": "え、教授ですか?"
    },
    {
      "start": 189.97,
      "end": 197.77,
      "text": "すみません。次回の説明会の申し込みの対応と、参加者への事前資料の発送の準備で忙しくて。"
    },
    {
      "start": 197.77,
      "end": 202.37,
      "text": "そう?うーん、対応の方は私がやるから。"
    },
    {
      "start": 202.37,
      "end": 208.27,
      "text": "資料の発送の方は、まだ時間があるから、今日じゃなくても大丈夫でしょ。"
    },
    {
      "start": 208.27,
      "end": 211.47,
      "text": "とりあえず、結果の方に集中してくれるかな。"
    },
    {
      "start": 211.47,
      "end": 215.97,
      "text": "あ、そうだ。参加者へのお礼のメールは、もう送った?"
    },
    {
      "start": 215.97,
      "end": 217.37,
      "text": "あ、それはもう。"
    },
    {
      "start": 217.37,
      "end": 219.47,
      "text": "そう。じゃあ、よろしくね。"
    },
    {
      "start": 219.47,
      "end": 227.7,
      "text": "はい。"
    },
    {
      "start": 227.7,
      "end": 247.54,
      "text": "男の人は、これからまず、何をしなければなりませんか?"
    },
    {
      "start": 247.54,
      "end": 249.14,
      "text": "3番。"
    },
    {
      "start": 249.14,
      "end": 254.94,
      "text": "会社で、女の人と課長が、商品のポスターについて話しています。"
    },
    {
      "start": 254.94,
      "end": 261.97,
      "text": "女の人は、ポスターをどう直しますか?"
    },
    {
      "start": 261.97,
      "end": 269.17,
      "text": "課長、今度発売するパソコンの宣伝用ポスターを作成したので、一度見ていただけますか?"
    },
    {
      "start": 269.17,
      "end": 274.17,
      "text": "はい。商品名の文字の色が、あんまり目立たないようだけど。"
    },
    {
      "start": 274.17,
      "end": 275.57,
      "text": "そうですか。"
    },
    {
      "start": 275.57,
      "end": 280.47,
      "text": "ああ、全体のバランスを見ると、統一感があるんだね。"
    },
    {
      "start": 280.47,
      "end": 288.77,
      "text": "今回の商品は、今までで最も薄型っていうのがアピールポイントだから、それをもっと全面に出した方がいいね。"
    },
    {
      "start": 288.77,
      "end": 295.77,
      "text": "厚さの具体的な数字は、大きく目立つように書いてあるけど、これだけでは厚さがわかりにくいね。"
    },
    {
      "start": 295.77,
      "end": 296.97,
      "text": "そうですか。"
    },
    {
      "start": 296.97,
      "end": 302.17,
      "text": "今までのものと、図で比較するとか、そういう感じの方がいいんじゃないかな。"
    },
    {
      "start": 302.17,
      "end": 303.97,
      "text": "はい。そうします。"
    },
    {
      "start": 303.97,
      "end": 310.77,
      "text": "前のモデルからの性能の変更点は、わかりやすくまとめてあるし、他に付け加えるものはないね。"
    },
    {
      "start": 310.77,
      "end": 312.77,
      "text": "あ、ありがとうございます。"
    },
    {
      "start": 312.77,
      "end": 315.57,
      "text": "それじゃあ、その一点だけ直してみてよ。"
    },
    {
      "start": 315.57,
      "end": 324.19,
      "text": "わかりました。"
    },
    {
      "start": 324.19,
      "end": 342.94,
      "text": "女の人は、ポスターをどう直しますか?"
    },
    {
      "start": 342.94,
      "end": 344.64,
      "text": "読んばん。"
    },
    {
      "start": 344.64,
      "end": 349.74,
      "text": "大学で、女の学生と男の学生が話しています。"
    },
    {
      "start": 349.74,
      "end": 355.18,
      "text": "女の学生は、これからまず何をしますか?"
    },
    {
      "start": 355.18,
      "end": 359.08,
      "text": "先輩、卒論の発表お疲れさまでした。"
    },
    {
      "start": 359.08,
      "end": 365.58,
      "text": "私も卒論に向けて、そろそろ準備をと考えてるんですけど、どうしたらいいか分からなくて…"
    },
    {
      "start": 365.58,
      "end": 371.48,
      "text": "そう。加藤さん、今度3年生になるもんね。テーマとかは決まってるの?"
    },
    {
      "start": 371.48,
      "end": 380.08,
      "text": "はい。先輩と同じように環境問題に興味があるので、環境を守る活動についてかけたらって思ってはいるんですが。"
    },
    {
      "start": 380.08,
      "end": 383.58,
      "text": "環境を守る活動といっても、いろいろあるよね。"
    },
    {
      "start": 383.58,
      "end": 390.08,
      "text": "例えば、文学作品やアートを通じて環境問題を訴えたりすることもあるしね。"
    },
    {
      "start": 390.08,
      "end": 392.68,
      "text": "文献とかは、もういくつか読んでるの?"
    },
    {
      "start": 392.68,
      "end": 396.18,
      "text": "まだ授業でテキストを一冊読んだくらいで。"
    },
    {
      "start": 396.18,
      "end": 401.38,
      "text": "そう。じゃあまず、活動についてまとめた文献を見てみて。"
    },
    {
      "start": 401.38,
      "end": 406.38,
      "text": "それで興味を感じるのがあったら、関連するイベントとかに参加してみて。"
    },
    {
      "start": 406.38,
      "end": 407.38,
      "text": "はい。"
    },
    {
      "start": 407.38,
      "end": 412.28,
      "text": "イベントとかに参加したら、具体的な問題点も見えてくると思うよ。"
    },
    {
      "start": 412.28,
      "end": 417.68,
      "text": "そしたら、それに関係のある研究をしている友達も紹介できるかもしれない。"
    },
    {
      "start": 417.68,
      "end": 421.68,
      "text": "そうですか。その時はまた相談させてください。"
    },
    {
      "start": 421.68,
      "end": 425.18,
      "text": "うん。何があるか知ることからだね。"
    },
    {
      "start": 425.18,
      "end": 433.56,
      "text": "わかりました。ありがとうございます。"
    },
    {
      "start": 433.56,
      "end": 452.74,
      "text": "女の学生はこれからまず何をしますか?"
    },
    {
      "start": 452.74,
      "end": 454.34,
      "text": "5番。"
    },
    {
      "start": 454.34,
      "end": 457.64,
      "text": "大学で職員が話しています。"
    },
    {
      "start": 457.64,
      "end": 463.74,
      "text": "ボランティアの参加者は、この後まず何をしますか?"
    },
    {
      "start": 463.74,
      "end": 469.24,
      "text": "学生へ職品を配るボランティア活動へのご参加。ありがとうございます。"
    },
    {
      "start": 469.24,
      "end": 473.24,
      "text": "こちらの教室で準備をし配ります。"
    },
    {
      "start": 473.24,
      "end": 479.14,
      "text": "これまでは、職品をまとめて袋に詰めたものを学生に渡しておりましたが、"
    },
    {
      "start": 479.14,
      "end": 487.34,
      "text": "一人あたりの数を決めて、学生に自由に選んで持ち帰ってもらう方法に変更となりました。"
    },
    {
      "start": 487.34,
      "end": 494.04,
      "text": "ええ、職員が入った段ボールをそれぞれの机の下に置いておきました。"
    },
    {
      "start": 494.04,
      "end": 499.84,
      "text": "取りやすいように箱の中身を机の上に置いてください。"
    },
    {
      "start": 499.84,
      "end": 506.94,
      "text": "配る際ですが、袋を持たずに来てしまった学生には袋の用意がないこと。"
    },
    {
      "start": 506.94,
      "end": 515.04,
      "text": "職品の数を取り過ぎてしまった学生がいた場合は、数に限りがあることをお伝えいただけますでしょうか。"
    },
    {
      "start": 515.04,
      "end": 523.29,
      "text": "それでは、よろしくお願いいたします。"
    },
    {
      "start": 523.29,
      "end": 543.78,
      "text": "ボランティアの参加者は、この後まず何をしますか?"
    },
    {
      "start": 543.78,
      "end": 550.68,
      "text": "問題2。問題2では、まず質問を聞いてください。"
    },
    {
      "start": 550.68,
      "end": 555.38,
      "text": "その後、問題用紙の選択肢を読んでください。"
    },
    {
      "start": 555.38,
      "end": 558.28,
      "text": "読む時間があります。"
    },
    {
      "start": 558.28,
      "end": 569.06,
      "text": "それから話を聞いて、問題用紙の1から4の中から最も良いものを一つ選んでください。"
    },
    {
      "start": 569.06,
      "end": 577.26,
      "text": "では、始めます。"
    },
    {
      "start": 577.26,
      "end": 578.86,
      "text": "一番"
    },
    {
      "start": 578.86,
      "end": 584.76,
      "text": "大学で、男の留学生と女の留学生が話しています。"
    },
    {
      "start": 584.76,
      "end": 615.22,
      "text": "女の留学生は、男の留学生に、新しくどんなアドバイスをしましたか?"
    },
    {
      "start": 615.22,
      "end": 620.62,
      "text": "ジョアンさん、この間、就職の面接試験の相談に乗ってもらったじゃない?"
    },
    {
      "start": 620.62,
      "end": 623.12,
      "text": "なのに面接うまくいかなかったんだ。"
    },
    {
      "start": 623.12,
      "end": 625.02,
      "text": "え、どうしたの?"
    },
    {
      "start": 625.02,
      "end": 633.02,
      "text": "最初は良かったんだけど、途中面接感の表情が気になりだしたら、緊張して口が動かなくなっちゃって。"
    },
    {
      "start": 633.02,
      "end": 637.02,
      "text": "何か他に対策法あったら教えてほしいんだけど、"
    },
    {
      "start": 637.02,
      "end": 641.22,
      "text": "ジョアンさん、もう就職試験いくつか浮かってるから。"
    },
    {
      "start": 641.22,
      "end": 648.62,
      "text": "心理学の本で読んだんだけど、表情を意識的に変えると、それに合わせて気分も変わるんだって。"
    },
    {
      "start": 648.62,
      "end": 652.22,
      "text": "だから、無理してでも笑顔で話してみたらどうかな。"
    },
    {
      "start": 652.22,
      "end": 653.62,
      "text": "そうなんだ。"
    },
    {
      "start": 653.62,
      "end": 658.52,
      "text": "表情に釣られて気持ちも明るくなって緊張も解けるかもよ。"
    },
    {
      "start": 658.52,
      "end": 663.22,
      "text": "面接感も、笑顔の学生に怖い顔はできないだろうし。"
    },
    {
      "start": 663.22,
      "end": 667.42,
      "text": "あ、話したいことのメモは作ってから面接に行った?"
    },
    {
      "start": 667.42,
      "end": 671.62,
      "text": "うん。メモを作るっていうアドバイス、役に立ったよ。"
    },
    {
      "start": 671.62,
      "end": 676.82,
      "text": "それと、初めにきちんと挨拶するっていうのはちゃんとできたんだけど。"
    },
    {
      "start": 676.82,
      "end": 685.22,
      "text": "さあ。あ、事前に日本人の友達との練習はこれまで通りやってね。その上でってことだよ。"
    },
    {
      "start": 685.22,
      "end": 693.6,
      "text": "うん。それは分かってる。ありがとう。"
    },
    {
      "start": 693.6,
      "end": 715.61,
      "text": "女の留学生は男の留学生に、新しくどんなアドバイスをしましたか?"
    },
    {
      "start": 715.61,
      "end": 717.21,
      "text": "2番。"
    },
    {
      "start": 717.21,
      "end": 722.61,
      "text": "ラジオでアナウンサーが、歌手の女の人にインタビューしています。"
    },
    {
      "start": 722.61,
      "end": 751.04,
      "text": "女の人はどのようにしてプロの歌手になったと言っていますか?"
    },
    {
      "start": 751.04,
      "end": 755.44,
      "text": "ゆうかさんは、小さい頃からプロの歌手になりたかったんですか?"
    },
    {
      "start": 755.44,
      "end": 759.74,
      "text": "はい。小さい頃から歌手になるのが夢でした。"
    },
    {
      "start": 759.74,
      "end": 768.64,
      "text": "それで、まずは有名な先生がいらっしゃる音楽の専門学校に入って、それからプロを目指そうと考えていました。"
    },
    {
      "start": 768.64,
      "end": 777.34,
      "text": "でも、親に大学は出た方がいいと言われて、それで大学に通いながら駅前で歌っていました。"
    },
    {
      "start": 777.34,
      "end": 782.44,
      "text": "音楽関係の人に声をかけられないかなと期待して、"
    },
    {
      "start": 782.44,
      "end": 788.44,
      "text": "いろんな音楽事務所に自分の歌を録音したものを送ったりもしてたんです。"
    },
    {
      "start": 788.44,
      "end": 802.43,
      "text": "その頃出た、音楽のコンテストで優勝したことから、今の事務所に所属して、歌を仕事にすることができました。"
    },
    {
      "start": 802.43,
      "end": 822.84,
      "text": "女の人は、どのようにしてプロの歌手になったと言っていますか?"
    },
    {
      "start": 822.84,
      "end": 824.44,
      "text": "3番。"
    },
    {
      "start": 824.44,
      "end": 828.54,
      "text": "会社で、課長と男の人が話しています。"
    },
    {
      "start": 828.54,
      "end": 856.8,
      "text": "課長は、男の人の何が良くなかったと言っていますか?"
    },
    {
      "start": 856.8,
      "end": 865.1,
      "text": "きのしたさん。オフィスグリーンの岡田様から電話があったんだけど、椅子の脳品、時間ギリギリだったんだって?"
    },
    {
      "start": 865.1,
      "end": 871.3,
      "text": "あ、課長、すみません。私が数を間違って工場に依頼してしまいました。"
    },
    {
      "start": 871.3,
      "end": 877.0,
      "text": "それで、同じ商品を扱っている京都市店に連絡して、何とか間に合わせました。"
    },
    {
      "start": 877.0,
      "end": 889.4,
      "text": "そうだったの。まあ、ミスは誰にでもあるけど、私聞いてなかったから、岡田様と話が合わなくて、上司に一言も報告がなかったのはどうかな?"
    },
    {
      "start": 889.4,
      "end": 893.4,
      "text": "本当にすみません。何とかしなくちゃって焦ってしまって…"
    },
    {
      "start": 893.4,
      "end": 898.3,
      "text": "そう。京都市店の小林部長には話通ってるの?"
    },
    {
      "start": 898.3,
      "end": 902.2,
      "text": "はい、ご相談しました。お礼の電話もしました。"
    },
    {
      "start": 902.2,
      "end": 907.9,
      "text": "京都市店から借りていた分は、来週出来上がるので工場から送ってもらうようにしています。"
    },
    {
      "start": 907.9,
      "end": 912.7,
      "text": "そう。じゃあ大丈夫そうね。次からは気をつけてね。"
    },
    {
      "start": 912.7,
      "end": 920.35,
      "text": "はい、すみませんでした。"
    },
    {
      "start": 920.35,
      "end": 940.39,
      "text": "課長は、男の人の何が良くなかったと言っていますか?"
    },
    {
      "start": 940.39,
      "end": 941.99,
      "text": "4番"
    },
    {
      "start": 941.99,
      "end": 945.09,
      "text": "テレビで医者が話しています。"
    },
    {
      "start": 945.09,
      "end": 973.69,
      "text": "夏の暑い時の食事で大切なことは、何だと言っていますか?"
    },
    {
      "start": 973.69,
      "end": 979.19,
      "text": "毎日、こう暑い日が続くと、食欲も衰えてしまいますね。"
    },
    {
      "start": 979.19,
      "end": 989.79,
      "text": "お腹が空いたら食べようでは、体が食事を受け付けるリズムがつかめないので、決まった時間に朝昼晩、毎日食べること。"
    },
    {
      "start": 989.79,
      "end": 996.69,
      "text": "私は、このことが、暑い夏を健康に過ごすためには大切なことだと思います。"
    },
    {
      "start": 996.69,
      "end": 1003.39,
      "text": "暑い時は、手軽で冷たいものや、喉の通りが良いものを好んで食べがちですが、"
    },
    {
      "start": 1003.39,
      "end": 1014.11,
      "text": "そのようなものばかり食べていると、異常の働きが弱まってしまいますよ。"
    },
    {
      "start": 1014.11,
      "end": 1034.72,
      "text": "夏の暑い時の食事で大切なことは、何だと言っていますか?"
    },
    {
      "start": 1034.72,
      "end": 1036.22,
      "text": "5番"
    },
    {
      "start": 1036.22,
      "end": 1041.42,
      "text": "電話で、駅のかかりの人と女の人が話しています。"
    },
    {
      "start": 1041.42,
      "end": 1074.63,
      "text": "女の人は、お年者を受け取るためにどうしますか?"
    },
    {
      "start": 1074.63,
      "end": 1078.13,
      "text": "はい。桜駅お年者センターです。"
    },
    {
      "start": 1078.13,
      "end": 1085.93,
      "text": "すみません。昨日大学から帰る時に、定期券を森川駅で落としてしまったみたいなんですけど、"
    },
    {
      "start": 1085.93,
      "end": 1091.63,
      "text": "お年者センターのあるそちらの桜駅に連絡してほしいって言われまして、"
    },
    {
      "start": 1091.63,
      "end": 1095.23,
      "text": "問い合わせ番号は1904です。"
    },
    {
      "start": 1095.23,
      "end": 1100.83,
      "text": "わかりました。昨日17日の金曜日ですね。"
    },
    {
      "start": 1100.83,
      "end": 1105.7,
      "text": "お調べしますので、少々お待ちください。"
    },
    {
      "start": 1105.7,
      "end": 1109.7,
      "text": "はい。確かにこちらに届いております。"
    },
    {
      "start": 1109.7,
      "end": 1115.9,
      "text": "定期券は貴重品ですので、こちらでは一時的にお預かりするだけで、"
    },
    {
      "start": 1115.9,
      "end": 1121.2,
      "text": "明日には警察署に落としものとして届けることになってるんですが、"
    },
    {
      "start": 1121.2,
      "end": 1123.8,
      "text": "本日起こしになれますか?"
    },
    {
      "start": 1123.8,
      "end": 1129.6,
      "text": "え?今日はちょっと、うちから遠いんですよね。"
    },
    {
      "start": 1129.6,
      "end": 1135.5,
      "text": "あの、ちなみに、拓配便で送ってもらうことも可能だと伺ったのですが、"
    },
    {
      "start": 1135.5,
      "end": 1140.3,
      "text": "もより駅は西山駅ですが、拓配便の手続きできますか?"
    },
    {
      "start": 1140.3,
      "end": 1142.4,
      "text": "はい。可能です。"
    },
    {
      "start": 1142.4,
      "end": 1147.6,
      "text": "料金は1000円程度。お日にちは2日ほどかかりますが。"
    },
    {
      "start": 1147.6,
      "end": 1155.2,
      "text": "そうですか。2日もかかるのは困るので、なんとか拓重にそちらに伺います。"
    },
    {
      "start": 1155.2,
      "end": 1162.21,
      "text": "掃除いたしました。"
    },
    {
      "start": 1162.21,
      "end": 1182.06,
      "text": "女の人は落としものを受け取るために、どうしますか?"
    },
    {
      "start": 1182.06,
      "end": 1183.76,
      "text": "6番。"
    },
    {
      "start": 1183.76,
      "end": 1187.86,
      "text": "防災教室で、公司が話しています。"
    },
    {
      "start": 1187.86,
      "end": 1217.56,
      "text": "公司は防災グッズに関して、一番大切なことは何だと言っていますか?"
    },
    {
      "start": 1217.56,
      "end": 1222.26,
      "text": "年々、人々の防災意識は高まっていると思います。"
    },
    {
      "start": 1222.26,
      "end": 1229.06,
      "text": "非常食や簡易トイレなど、防災グッズにも関心を持つ方が増えているようです。"
    },
    {
      "start": 1229.06,
      "end": 1236.26,
      "text": "それはとても良いことですが、防災グッズを解揃えることが防災だと考える人が多く、"
    },
    {
      "start": 1236.26,
      "end": 1244.56,
      "text": "普段の暮らしの中で実際に防災グッズを使ってみようと考える人は意外に少ないですね。"
    },
    {
      "start": 1244.56,
      "end": 1254.96,
      "text": "でも、防災で一番大切なことは実はこれで、防災グッズを定期的に見直すことは皆さん頭にあるんですが、"
    },
    {
      "start": 1254.96,
      "end": 1268.17,
      "text": "災害の際にちゃんと使うことができて、初めて意味があることを忘れずに言ってもらいたいです。"
    },
    {
      "start": 1268.17,
      "end": 1286.78,
      "text": "公司は防災グッズに関して、一番大切なことは何だと言っていますか?"
    },
    {
      "start": 1286.78,
      "end": 1321.78,
      "text": "ここでちょっと休みましょう。"
    },
    {
      "start": 1321.78,
      "end": 1329.7,
      "text": "では、また続けます。"
    },
    {
      "start": 1329.7,
      "end": 1331.6,
      "text": "問題3。"
    },
    {
      "start": 1331.6,
      "end": 1337.6,
      "text": "問題3では、問題用紙に何も印刷されていません。"
    },
    {
      "start": 1337.6,
      "end": 1344.3,
      "text": "この問題は、全体としてどんな内容かを聞く問題です。"
    },
    {
      "start": 1344.3,
      "end": 1347.5,
      "text": "話の前に質問はありません。"
    },
    {
      "start": 1347.5,
      "end": 1350.8,
      "text": "まず話を聞いてください。"
    },
    {
      "start": 1350.8,
      "end": 1361.84,
      "text": "それから、質問と選択肢を聞いて、1から4の中から最も良いものを一つ選んでください。"
    },
    {
      "start": 1361.84,
      "end": 1370.48,
      "text": "では、始めます。"
    },
    {
      "start": 1370.48,
      "end": 1372.08,
      "text": "1番。"
    },
    {
      "start": 1372.08,
      "end": 1378.78,
      "text": "女の人と男の人が子供向けの絵本について話しています。"
    },
    {
      "start": 1378.78,
      "end": 1384.98,
      "text": "子供の絵本も電子書籍がたくさん出てるけど、うちはあんまり使ってないんだよね。"
    },
    {
      "start": 1384.98,
      "end": 1387.58,
      "text": "目に悪いかなって思って。"
    },
    {
      "start": 1387.58,
      "end": 1389.48,
      "text": "吉田さんのうちはどう?"
    },
    {
      "start": 1389.48,
      "end": 1395.18,
      "text": "うちは子供のお気に入りの本は、紙と電子書籍の両方を買ってるよ。"
    },
    {
      "start": 1395.18,
      "end": 1401.98,
      "text": "病院やレストランで待ってる時間とか、長い移動の時は電子書籍が必受品だな。"
    },
    {
      "start": 1401.98,
      "end": 1406.38,
      "text": "何冊でも持っていけるし、紙の本だと思くなるから。"
    },
    {
      "start": 1406.38,
      "end": 1409.48,
      "text": "あ、でも、家では紙だよ。"
    },
    {
      "start": 1409.48,
      "end": 1415.08,
      "text": "だから、全体的に見たら紙の本を見てる時間のほうが長いんじゃないかな。"
    },
    {
      "start": 1415.08,
      "end": 1423.0,
      "text": "あ、そうなんだ。"
    },
    {
      "start": 1423.0,
      "end": 1428.1,
      "text": "男の人は何について話していますか?"
    },
    {
      "start": 1428.1,
      "end": 1429.5,
      "text": "1。"
    },
    {
      "start": 1429.5,
      "end": 1435.21,
      "text": "電子書籍が目に与える影響。"
    },
    {
      "start": 1435.21,
      "end": 1436.51,
      "text": "2。"
    },
    {
      "start": 1436.51,
      "end": 1442.91,
      "text": "電子書籍より紙の本のほうがいい理由。"
    },
    {
      "start": 1442.91,
      "end": 1444.31,
      "text": "3。"
    },
    {
      "start": 1444.31,
      "end": 1449.89,
      "text": "子供が好きな電子書籍の特徴。"
    },
    {
      "start": 1449.89,
      "end": 1451.29,
      "text": "4。"
    },
    {
      "start": 1451.29,
      "end": 1465.73,
      "text": "電子書籍と紙の本の使い分け。"
    },
    {
      "start": 1465.73,
      "end": 1467.23,
      "text": "2。"
    },
    {
      "start": 1467.23,
      "end": 1473.53,
      "text": "市民講座でボランティア団体の男の人が話しています。"
    },
    {
      "start": 1473.53,
      "end": 1481.33,
      "text": "私はここ、ふるさとの南島で、10年前から海岸の清掃ボランティアを行っています。"
    },
    {
      "start": 1481.33,
      "end": 1484.83,
      "text": "海岸には色んなゴミが落ちています。"
    },
    {
      "start": 1484.83,
      "end": 1488.83,
      "text": "ペットボトルやビニール袋などです。"
    },
    {
      "start": 1488.83,
      "end": 1497.03,
      "text": "私はこういうゴミは、島の外から流れてきて、ここに打ち上げられているとずっと思っていたのですが、"
    },
    {
      "start": 1497.03,
      "end": 1503.43,
      "text": "実は、島の川から海に流れてきたものがほとんどなんです。"
    },
    {
      "start": 1503.43,
      "end": 1511.63,
      "text": "道端に捨てられたものとか、風で飛んでしまったものが川に落ちて、そして海に。"
    },
    {
      "start": 1511.63,
      "end": 1522.74,
      "text": "多くは地元からっていうのはショックでしたし、皆さんに知ってもらいたいと思います。"
    },
    {
      "start": 1522.74,
      "end": 1529.14,
      "text": "海岸のゴミについて、男の人が伝えたいことは何ですか?"
    },
    {
      "start": 1529.14,
      "end": 1530.44,
      "text": "1。"
    },
    {
      "start": 1530.44,
      "end": 1535.45,
      "text": "地元から出たものが多いこと。"
    },
    {
      "start": 1535.45,
      "end": 1536.75,
      "text": "2。"
    },
    {
      "start": 1536.75,
      "end": 1541.62,
      "text": "量が年々増えていること。"
    },
    {
      "start": 1541.62,
      "end": 1543.02,
      "text": "3。"
    },
    {
      "start": 1543.02,
      "end": 1547.9,
      "text": "ボランティアが掃除していること。"
    },
    {
      "start": 1547.9,
      "end": 1549.3,
      "text": "4。"
    },
    {
      "start": 1549.3,
      "end": 1563.88,
      "text": "種類ごとに分ける作業が大変であること。"
    },
    {
      "start": 1563.88,
      "end": 1565.58,
      "text": "3番。"
    },
    {
      "start": 1565.58,
      "end": 1570.45,
      "text": "シンポジウムで専門家が話しています。"
    },
    {
      "start": 1570.45,
      "end": 1575.25,
      "text": "すっかり子供の生活の一部に定着したコンピューターゲームですが、"
    },
    {
      "start": 1575.25,
      "end": 1580.35,
      "text": "暴力的な内容のものもあり、親としては心配になりますよね。"
    },
    {
      "start": 1580.35,
      "end": 1587.25,
      "text": "確かに、そういったゲームへの批判は、新聞やテレビなどメディアでも取り上げられますし、"
    },
    {
      "start": 1587.25,
      "end": 1590.15,
      "text": "対策をとろうという声もありますが、"
    },
    {
      "start": 1590.15,
      "end": 1593.55,
      "text": "暴力的なシーンと子供の攻撃性については、"
    },
    {
      "start": 1593.55,
      "end": 1598.95,
      "text": "必ずしも関連性があるとは限らないという研究結果も見られます。"
    },
    {
      "start": 1598.95,
      "end": 1603.55,
      "text": "長時間、一人でゲームばかりしているのは問題だと思いますが、"
    },
    {
      "start": 1603.55,
      "end": 1607.05,
      "text": "ゲームには友達と情報交換をしたり、"
    },
    {
      "start": 1607.05,
      "end": 1609.25,
      "text": "遊び方を教えあったりと、"
    },
    {
      "start": 1609.25,
      "end": 1620.16,
      "text": "人間関係やコミュニケーション能力を育てる面もあると考えられています。"
    },
    {
      "start": 1620.16,
      "end": 1624.56,
      "text": "専門家が伝えたいことは何ですか?"
    },
    {
      "start": 1624.56,
      "end": 1625.96,
      "text": "1。"
    },
    {
      "start": 1625.96,
      "end": 1631.57,
      "text": "暴力的なゲームを減らすための取り組み。"
    },
    {
      "start": 1631.57,
      "end": 1632.87,
      "text": "2。"
    },
    {
      "start": 1632.87,
      "end": 1638.24,
      "text": "ゲームには良い側面もあるということ。"
    },
    {
      "start": 1638.24,
      "end": 1639.64,
      "text": "3。"
    },
    {
      "start": 1639.64,
      "end": 1645.18,
      "text": "ゲームをする子供が抱える問題点。"
    },
    {
      "start": 1645.18,
      "end": 1646.58,
      "text": "4。"
    },
    {
      "start": 1646.58,
      "end": 1660.62,
      "text": "子供がゲームに夢中になる理由。"
    },
    {
      "start": 1660.62,
      "end": 1662.22,
      "text": "4番。"
    },
    {
      "start": 1662.22,
      "end": 1666.42,
      "text": "ラジオでコックが話しています。"
    },
    {
      "start": 1666.42,
      "end": 1669.22,
      "text": "私はレストランで働きながら、"
    },
    {
      "start": 1669.22,
      "end": 1673.52,
      "text": "出張料理サービスにも登録して働いています。"
    },
    {
      "start": 1673.52,
      "end": 1676.22,
      "text": "個人のお客様から指名を受けて、"
    },
    {
      "start": 1676.22,
      "end": 1678.32,
      "text": "お客様の家のキッチンで、"
    },
    {
      "start": 1678.32,
      "end": 1681.42,
      "text": "ご希望に合わせた料理を作ります。"
    },
    {
      "start": 1681.42,
      "end": 1684.42,
      "text": "店よりお客様との距離が近く、"
    },
    {
      "start": 1684.42,
      "end": 1688.12,
      "text": "常にお客様から見られていて緊張もしますが、"
    },
    {
      "start": 1688.12,
      "end": 1690.82,
      "text": "刺激的で楽しいです。"
    },
    {
      "start": 1690.82,
      "end": 1693.62,
      "text": "お客様の反応が時間に分かるので、"
    },
    {
      "start": 1693.62,
      "end": 1698.02,
      "text": "レストランだけで働いていた頃よりやりがいがあります。"
    },
    {
      "start": 1698.02,
      "end": 1707.47,
      "text": "これからも指名をいただける料理人を目指したいです。"
    },
    {
      "start": 1707.47,
      "end": 1708.67,
      "text": "コックは、"
    },
    {
      "start": 1708.67,
      "end": 1712.37,
      "text": "何について話していますか?"
    },
    {
      "start": 1712.37,
      "end": 1713.77,
      "text": "1。"
    },
    {
      "start": 1713.77,
      "end": 1719.28,
      "text": "出張サービスに登録したきっかけ。"
    },
    {
      "start": 1719.28,
      "end": 1720.58,
      "text": "2。"
    },
    {
      "start": 1720.58,
      "end": 1722.58,
      "text": "出張サービスの料理と、"
    },
    {
      "start": 1722.58,
      "end": 1727.05,
      "text": "店の料理との違い。"
    },
    {
      "start": 1727.05,
      "end": 1728.45,
      "text": "3。"
    },
    {
      "start": 1728.45,
      "end": 1734.13,
      "text": "出張サービスで指名を受ける方法。"
    },
    {
      "start": 1734.13,
      "end": 1735.53,
      "text": "4。"
    },
    {
      "start": 1735.53,
      "end": 1749.5,
      "text": "出張サービスで働く魅力。"
    },
    {
      "start": 1749.5,
      "end": 1751.1,
      "text": "5番。"
    },
    {
      "start": 1751.1,
      "end": 1757.65,
      "text": "公演会で、アナウンサーの男の人と専門家が話しています。"
    },
    {
      "start": 1757.65,
      "end": 1760.25,
      "text": "人工知能がどんどん発達し、"
    },
    {
      "start": 1760.25,
      "end": 1763.45,
      "text": "社会に大きく影響すると思われますが、"
    },
    {
      "start": 1763.45,
      "end": 1766.55,
      "text": "先生はどのようにお考えですか?"
    },
    {
      "start": 1766.55,
      "end": 1767.85,
      "text": "お店のレジ、"
    },
    {
      "start": 1767.85,
      "end": 1771.75,
      "text": "ホテルの受付やスポーツの審判などはすでに、"
    },
    {
      "start": 1771.75,
      "end": 1776.25,
      "text": "人工知能を活用した機会がしているものもありますね。"
    },
    {
      "start": 1776.25,
      "end": 1782.55,
      "text": "今後、人に代わって人工知能が行う仕事はさらに増えていくでしょう。"
    },
    {
      "start": 1782.55,
      "end": 1785.85,
      "text": "一方で、人間の仕事を奪うとか、"
    },
    {
      "start": 1785.85,
      "end": 1789.85,
      "text": "人間の能力が下がるといった不安の声も聞かれますが、"
    },
    {
      "start": 1789.85,
      "end": 1794.55,
      "text": "私は否定的に考えずに、別の側面を期待しています。"
    },
    {
      "start": 1794.55,
      "end": 1795.85,
      "text": "とおっしゃいますと?"
    },
    {
      "start": 1795.85,
      "end": 1798.75,
      "text": "例えば、生技のプロの中には、"
    },
    {
      "start": 1798.75,
      "end": 1802.75,
      "text": "人工知能を利用したコンピューターとの対決を通し、"
    },
    {
      "start": 1802.75,
      "end": 1807.05,
      "text": "腕を鍛え、活躍が一尻しい人もいます。"
    },
    {
      "start": 1807.05,
      "end": 1812.55,
      "text": "生技だけではなく、外国語の能力を向上させるプログラムなども今後、"
    },
    {
      "start": 1812.55,
      "end": 1815.05,
      "text": "どんどん開発されるでしょう。"
    },
    {
      "start": 1815.05,
      "end": 1825.76,
      "text": "能力の向上を目指す人は、これらを使わないではないと思います。"
    },
    {
      "start": 1825.76,
      "end": 1831.96,
      "text": "専門家は、人工知能についてどう考えていますか?"
    },
    {
      "start": 1831.96,
      "end": 1833.36,
      "text": "一。"
    },
    {
      "start": 1833.36,
      "end": 1838.97,
      "text": "利点を積極的に活用すべきだ。"
    },
    {
      "start": 1838.97,
      "end": 1840.17,
      "text": "二。"
    },
    {
      "start": 1840.17,
      "end": 1845.54,
      "text": "人間の仕事を奪う恐れがある。"
    },
    {
      "start": 1845.54,
      "end": 1846.94,
      "text": "三。"
    },
    {
      "start": 1846.94,
      "end": 1852.82,
      "text": "使いすぎると、人の能力が低下する。"
    },
    {
      "start": 1852.82,
      "end": 1854.22,
      "text": "四。"
    },
    {
      "start": 1854.22,
      "end": 1869.05,
      "text": "開発のスピードをもっと早めるべきだ。"
    },
    {
      "start": 1869.05,
      "end": 1870.95,
      "text": "問題4。"
    },
    {
      "start": 1870.95,
      "end": 1876.85,
      "text": "問題4では、問題用紙に何も印刷されていません。"
    },
    {
      "start": 1876.85,
      "end": 1880.25,
      "text": "まず、文を聞いてください。"
    },
    {
      "start": 1880.25,
      "end": 1883.95,
      "text": "それから、それに対する返事を聞いて、"
    },
    {
      "start": 1883.95,
      "end": 1891.86,
      "text": "1から3の中から、最も良いものを一つ選んでください。"
    },
    {
      "start": 1891.86,
      "end": 1900.14,
      "text": "では、始めます。"
    },
    {
      "start": 1900.14,
      "end": 1901.74,
      "text": "一番。"
    },
    {
      "start": 1901.84,
      "end": 1908.14,
      "text": "明日漢字のテストなんだけど、全部は覚えきれてないんだよね。"
    },
    {
      "start": 1908.14,
      "end": 1909.54,
      "text": "一。"
    },
    {
      "start": 1909.54,
      "end": 1913.14,
      "text": "全部覚えたのはすごいね。"
    },
    {
      "start": 1913.14,
      "end": 1914.44,
      "text": "二。"
    },
    {
      "start": 1914.44,
      "end": 1918.29,
      "text": "え、一つも覚えてないの?"
    },
    {
      "start": 1918.29,
      "end": 1919.59,
      "text": "三。"
    },
    {
      "start": 1919.59,
      "end": 1933.46,
      "text": "多すぎて覚えるの大変だよね。"
    },
    {
      "start": 1933.46,
      "end": 1934.96,
      "text": "二番。"
    },
    {
      "start": 1934.96,
      "end": 1943.34,
      "text": "盛さん。盛さん担当の桜川の橋の建設は、計画通りに行ってないよだね。"
    },
    {
      "start": 1943.34,
      "end": 1944.74,
      "text": "一。"
    },
    {
      "start": 1944.74,
      "end": 1949.22,
      "text": "それは順調に進んでるってことですね。"
    },
    {
      "start": 1949.22,
      "end": 1950.52,
      "text": "二。"
    },
    {
      "start": 1950.52,
      "end": 1955.14,
      "text": "はい。雨で工事が遅れまして。"
    },
    {
      "start": 1955.14,
      "end": 1956.54,
      "text": "三。"
    },
    {
      "start": 1956.54,
      "end": 1970.28,
      "text": "おかげさまでありがとうございます。"
    },
    {
      "start": 1970.28,
      "end": 1971.98,
      "text": "三番。"
    },
    {
      "start": 1971.98,
      "end": 1976.58,
      "text": "映画館、平日の昼にしては混んでたね。"
    },
    {
      "start": 1976.58,
      "end": 1977.98,
      "text": "一。"
    },
    {
      "start": 1977.98,
      "end": 1982.18,
      "text": "そう、いつも混んでるんだね。"
    },
    {
      "start": 1982.18,
      "end": 1983.48,
      "text": "二。"
    },
    {
      "start": 1983.48,
      "end": 1987.86,
      "text": "休日でもないのに人が多かったね。"
    },
    {
      "start": 1987.86,
      "end": 1989.26,
      "text": "三。"
    },
    {
      "start": 1989.26,
      "end": 2003.5,
      "text": "平日だったらもっとすいてたかもね。"
    },
    {
      "start": 2003.5,
      "end": 2005.1,
      "text": "四番。"
    },
    {
      "start": 2005.1,
      "end": 2010.5,
      "text": "昨日の休みは、一日だらだらしちゃったよ。"
    },
    {
      "start": 2010.5,
      "end": 2011.8,
      "text": "一。"
    },
    {
      "start": 2011.8,
      "end": 2015.7,
      "text": "一日充実してたんだね。"
    },
    {
      "start": 2015.7,
      "end": 2017.0,
      "text": "二。"
    },
    {
      "start": 2017.0,
      "end": 2021.68,
      "text": "せっかくの休みなのに忙しかったんだね。"
    },
    {
      "start": 2021.68,
      "end": 2023.08,
      "text": "三。"
    },
    {
      "start": 2023.08,
      "end": 2036.99,
      "text": "たまには何もしないのもいいんじゃない?"
    },
    {
      "start": 2036.99,
      "end": 2038.49,
      "text": "五番。"
    },
    {
      "start": 2038.49,
      "end": 2043.69,
      "text": "このコース料理、ちょっと物足りなくない?"
    },
    {
      "start": 2043.69,
      "end": 2044.99,
      "text": "一。"
    },
    {
      "start": 2044.99,
      "end": 2048.64,
      "text": "何か追加で注文する?"
    },
    {
      "start": 2048.64,
      "end": 2049.94,
      "text": "二。"
    },
    {
      "start": 2049.94,
      "end": 2053.18,
      "text": "満足したってこと?"
    },
    {
      "start": 2053.18,
      "end": 2054.48,
      "text": "三。"
    },
    {
      "start": 2054.48,
      "end": 2068.12,
      "text": "量が多くて食べきれないね。"
    },
    {
      "start": 2068.12,
      "end": 2069.72,
      "text": "六番。"
    },
    {
      "start": 2069.72,
      "end": 2075.42,
      "text": "あ、アパートのエアコンつけっぱなしで出てきちゃった。"
    },
    {
      "start": 2075.42,
      "end": 2076.72,
      "text": "一。"
    },
    {
      "start": 2076.72,
      "end": 2080.12,
      "text": "あ、消してきたんだ。"
    },
    {
      "start": 2080.12,
      "end": 2081.42,
      "text": "二。"
    },
    {
      "start": 2081.42,
      "end": 2084.84,
      "text": "エアコンつかなかったの?"
    },
    {
      "start": 2084.84,
      "end": 2086.24,
      "text": "三。"
    },
    {
      "start": 2086.24,
      "end": 2100.11,
      "text": "え、一度帰って消してくる?"
    },
    {
      "start": 2100.11,
      "end": 2101.71,
      "text": "七番。"
    },
    {
      "start": 2101.71,
      "end": 2106.76,
      "text": "寒い時の旅行は温泉に限りよね。"
    },
    {
      "start": 2106.76,
      "end": 2108.06,
      "text": "一。"
    },
    {
      "start": 2108.06,
      "end": 2111.46,
      "text": "温泉に行かないの?"
    },
    {
      "start": 2111.46,
      "end": 2112.66,
      "text": "二。"
    },
    {
      "start": 2112.66,
      "end": 2116.37,
      "text": "温泉が一番だよね。"
    },
    {
      "start": 2116.37,
      "end": 2117.77,
      "text": "三。"
    },
    {
      "start": 2117.77,
      "end": 2131.28,
      "text": "温泉は苦手なんだね。"
    },
    {
      "start": 2131.28,
      "end": 2132.88,
      "text": "八番。"
    },
    {
      "start": 2132.88,
      "end": 2139.48,
      "text": "さっきの映画、最後の音楽が全てを大なしにしてたと思わない?"
    },
    {
      "start": 2139.48,
      "end": 2140.88,
      "text": "一。"
    },
    {
      "start": 2140.88,
      "end": 2146.08,
      "text": "音楽のおかげで、最後まで映画が楽しめたね。"
    },
    {
      "start": 2146.08,
      "end": 2147.38,
      "text": "二。"
    },
    {
      "start": 2147.38,
      "end": 2151.58,
      "text": "最後があの音楽じゃ、ちょっとね。"
    },
    {
      "start": 2151.58,
      "end": 2152.98,
      "text": "三。"
    },
    {
      "start": 2152.98,
      "end": 2166.76,
      "text": "最後の音楽だけは良かったよね。"
    },
    {
      "start": 2166.76,
      "end": 2168.36,
      "text": "九番。"
    },
    {
      "start": 2168.36,
      "end": 2178.4,
      "text": "山田さん、週末の緑公園でのイベントですが、雨だった場合に備えて、予備を設定しましょうか。"
    },
    {
      "start": 2178.4,
      "end": 2179.7,
      "text": "一。"
    },
    {
      "start": 2179.7,
      "end": 2184.0,
      "text": "天気のことは考えなくていいですか?"
    },
    {
      "start": 2184.0,
      "end": 2185.2,
      "text": "二。"
    },
    {
      "start": 2185.2,
      "end": 2189.68,
      "text": "あらかじめ決めておくと安心ですね。"
    },
    {
      "start": 2189.68,
      "end": 2191.08,
      "text": "三。"
    },
    {
      "start": 2191.08,
      "end": 2205.16,
      "text": "雨になってから考えればいいんですね。"
    },
    {
      "start": 2205.16,
      "end": 2206.76,
      "text": "十番。"
    },
    {
      "start": 2206.76,
      "end": 2212.26,
      "text": "ここのアルバイトの募集、経験を問わずって書いてあるよ。"
    },
    {
      "start": 2212.26,
      "end": 2213.66,
      "text": "一。"
    },
    {
      "start": 2213.66,
      "end": 2218.26,
      "text": "経験なくていいなら応募してみようかな。"
    },
    {
      "start": 2218.26,
      "end": 2219.56,
      "text": "二。"
    },
    {
      "start": 2219.56,
      "end": 2223.64,
      "text": "経験がないと難しいんだね。"
    },
    {
      "start": 2223.64,
      "end": 2225.04,
      "text": "三。"
    },
    {
      "start": 2225.04,
      "end": 2238.72,
      "text": "え、どんな経験が必要?"
    },
    {
      "start": 2238.72,
      "end": 2240.62,
      "text": "十一番。"
    },
    {
      "start": 2240.62,
      "end": 2245.62,
      "text": "うちのチームが優勝なんてできっこないよね。"
    },
    {
      "start": 2245.62,
      "end": 2247.02,
      "text": "一。"
    },
    {
      "start": 2247.02,
      "end": 2251.12,
      "text": "私たちが勝つはずだって思ってる?"
    },
    {
      "start": 2251.12,
      "end": 2252.42,
      "text": "二。"
    },
    {
      "start": 2252.42,
      "end": 2256.6,
      "text": "優勝できるとは思わなかったよね。"
    },
    {
      "start": 2256.6,
      "end": 2258.0,
      "text": "三。"
    },
    {
      "start": 2258.0,
      "end": 2271.92,
      "text": "そんなこと言わないで頑張ろうよ。"
    },
    {
      "start": 2271.92,
      "end": 2273.72,
      "text": "問題五。"
    },
    {
      "start": 2273.72,
      "end": 2278.42,
      "text": "問題五では、長めの話を聞きます。"
    },
    {
      "start": 2278.42,
      "end": 2284.25,
      "text": "問題用紙に、目もをとっても構いません。"
    },
    {
      "start": 2284.25,
      "end": 2285.85,
      "text": "一番。"
    },
    {
      "start": 2285.85,
      "end": 2290.15,
      "text": "問題用紙に、何も印刷されていません。"
    },
    {
      "start": 2290.15,
      "end": 2293.85,
      "text": "まず、話を聞いてください。"
    },
    {
      "start": 2293.85,
      "end": 2304.89,
      "text": "それから、質問と選択肢を聞いて、一から四の中から、最も良いものを一つ選んでください。"
    },
    {
      "start": 2304.89,
      "end": 2312.52,
      "text": "では、始めます。"
    },
    {
      "start": 2312.52,
      "end": 2319.44,
      "text": "高校で、演劇部の生と二人と先生が話しています。"
    },
    {
      "start": 2319.44,
      "end": 2326.64,
      "text": "あの、先生、朝っての公演の衣装なんですが、主役の山田さんの衣装が汚れちゃったんです。"
    },
    {
      "start": 2326.64,
      "end": 2327.94,
      "text": "すみません。"
    },
    {
      "start": 2327.94,
      "end": 2334.24,
      "text": "さっき、ペンキがついちゃって、ここ、胸のあたり少しだけなんですが。"
    },
    {
      "start": 2334.24,
      "end": 2336.34,
      "text": "茶色のペンキですか?"
    },
    {
      "start": 2336.34,
      "end": 2339.24,
      "text": "白いドレスだから目立ちますね。"
    },
    {
      "start": 2339.24,
      "end": 2343.44,
      "text": "この衣装、主役が最後までずっと着るものですよね。"
    },
    {
      "start": 2343.44,
      "end": 2346.74,
      "text": "はい。洗剤で落とせるでしょうか。"
    },
    {
      "start": 2346.74,
      "end": 2353.24,
      "text": "それか、大きめの花かなんかの飾りを縫いつけて、汚れを隠したらどうかと思うんですが。"
    },
    {
      "start": 2353.24,
      "end": 2355.34,
      "text": "ああ、そうですね。"
    },
    {
      "start": 2355.34,
      "end": 2360.64,
      "text": "この衣装は諦めて、去年の劇で使った青いドレスにするのはどうでしょうか。"
    },
    {
      "start": 2360.64,
      "end": 2367.14,
      "text": "劇の中で、衣装の白い色について話すセリフが何か所かありましたよね。"
    },
    {
      "start": 2367.14,
      "end": 2370.84,
      "text": "今からセリフの変更はしない方がいいですね。"
    },
    {
      "start": 2370.84,
      "end": 2377.74,
      "text": "じゃあ、僕の母が合唱サークルに入ってて、白いドレスも持ってると思うので、聞いてみましょうか。"
    },
    {
      "start": 2377.74,
      "end": 2380.94,
      "text": "お母さんのドレス、大事なものなんじゃない?"
    },
    {
      "start": 2380.94,
      "end": 2383.54,
      "text": "もし汚れちゃったら、申し訳ないよ。"
    },
    {
      "start": 2383.54,
      "end": 2385.24,
      "text": "そうですよ。"
    },
    {
      "start": 2385.24,
      "end": 2390.64,
      "text": "やっぱり、ペンキが見えないように、何か縫いつけるのがいいんじゃないですか。"
    },
    {
      "start": 2390.64,
      "end": 2394.64,
      "text": "洗って、生地がダメになったら困りますからね。"
    },
    {
      "start": 2394.64,
      "end": 2402.48,
      "text": "わかりました。そうします。"
    },
    {
      "start": 2402.48,
      "end": 2408.28,
      "text": "問題を解決するために、どうすることにしましたか?"
    },
    {
      "start": 2408.28,
      "end": 2409.68,
      "text": "1"
    },
    {
      "start": 2409.68,
      "end": 2414.79,
      "text": "汚れたところを洗剤で洗う。"
    },
    {
      "start": 2414.79,
      "end": 2416.09,
      "text": "2"
    },
    {
      "start": 2416.09,
      "end": 2422.01,
      "text": "飾りをつけて汚れを隠す。"
    },
    {
      "start": 2422.01,
      "end": 2423.31,
      "text": "3"
    },
    {
      "start": 2423.31,
      "end": 2427.98,
      "text": "青いドレスに変更する。"
    },
    {
      "start": 2427.98,
      "end": 2429.38,
      "text": "4"
    },
    {
      "start": 2429.38,
      "end": 2444.05,
      "text": "男の生徒のお母さんのドレスを借りる。"
    },
    {
      "start": 2444.05,
      "end": 2445.65,
      "text": "2"
    },
    {
      "start": 2445.65,
      "end": 2449.05,
      "text": "まず話を聞いてください。"
    },
    {
      "start": 2449.05,
      "end": 2461.82,
      "text": "それから2つの質問を聞いて、それぞれ問題用紙の1から4の中から、最も良いものを1つ選んでください。"
    },
    {
      "start": 2461.82,
      "end": 2469.56,
      "text": "では、始めます。"
    },
    {
      "start": 2469.56,
      "end": 2474.26,
      "text": "団体旅行で旅行会社の人の説明を聞いて、"
    },
    {
      "start": 2474.36,
      "end": 2479.1,
      "text": "男の人と女の人が話しています。"
    },
    {
      "start": 2479.1,
      "end": 2481.8,
      "text": "明日は自由行動です。"
    },
    {
      "start": 2481.8,
      "end": 2487.8,
      "text": "観光コースも4つご用意していますので、ご希望の方はご参加ください。"
    },
    {
      "start": 2487.8,
      "end": 2494.2,
      "text": "どのコースも半日コースで、1日2回、午前と午後に行われます。"
    },
    {
      "start": 2494.2,
      "end": 2498.8,
      "text": "1番のコースは、市内の自然公園のハイキングです。"
    },
    {
      "start": 2498.8,
      "end": 2503.0,
      "text": "綺麗な湖の周りをガイドと一緒に歩きます。"
    },
    {
      "start": 2503.0,
      "end": 2511.8,
      "text": "2番のコースは、この町出身の作家の生まれた家や、作品に登場する場所を自転車で巡ります。"
    },
    {
      "start": 2511.8,
      "end": 2519.6,
      "text": "3番のコースは、市内の神社や寺をバスで回り、この地域の歴史に触れるコースです。"
    },
    {
      "start": 2519.6,
      "end": 2529.2,
      "text": "4番のコースは、市内の筆作り工場に行き、実際に書道の筆を作る体験ができます。"
    },
    {
      "start": 2529.2,
      "end": 2539.5,
      "text": "どれも面白そうだね。午前と午後一つずつ選ぼうよ。明日は天気が良さそうだから、外を歩いたり自転車に乗ったりするのにしない?"
    },
    {
      "start": 2539.5,
      "end": 2548.6,
      "text": "うーん。湖のコースは、パンフレットに2時間近く歩くって書いてあったよ。ちょっと自信ないな。"
    },
    {
      "start": 2548.6,
      "end": 2551.6,
      "text": "作家の家とかを回る方ならいいけど。"
    },
    {
      "start": 2551.6,
      "end": 2557.2,
      "text": "じゃあ午前中はそれにして、午後はどうする?お寺や神舎にでも行く?"
    },
    {
      "start": 2557.2,
      "end": 2569.8,
      "text": "今読んでる歴史小説、主人公が書道の名人っていう設定で筆とかの道具の話もよく出てくるんだ。だからすごく興味があって、午後はそれがいいな。"
    },
    {
      "start": 2569.8,
      "end": 2576.74,
      "text": "じゃあそうしよう。"
    },
    {
      "start": 2576.74,
      "end": 2578.94,
      "text": "質問1"
    },
    {
      "start": 2578.94,
      "end": 2597.09,
      "text": "明日の午前。2人はどのコースに参加しますか?"
    },
    {
      "start": 2597.09,
      "end": 2599.09,
      "text": "質問2"
    },
    {
      "start": 2599.09,
      "end": 2603.69,
      "text": "明日の午後。2人はどのコースに参加しますか?"
    }
  ]
}