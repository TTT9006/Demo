    },
    {
      "start": 1504.76,
      "end": 1509.36,
      "text": "チケットは、船の中で買うことができます。"
    },
    {
      "start": 1509.36,
      "end": 1517.91,
      "text": "皆様、乗ってみませんか?"
    },
    {
      "start": 1518.01,
      "end": 1538.95,
      "text": "次の船は、何時に出発しますか?"
    },
