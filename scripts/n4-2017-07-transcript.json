      "text": "一番いいものは、3番ですから。"
    },
    {
      "start": 1609.32,
      "end": 1614.98,
      "text": "答えはこのように書きます。"
    },
    {
      "start": 1614.98,
      "end": 1624.3,
      "text": "では、始めます。"
    },
    {
      "start": 1624.3,
      "end": 1625.9,
      "text": "1番"
    },
    {
      "start": 1625.9,
      "end": 1628.5,
      "text": "お土産を買いました。"
    },
    {
      "start": 1628.5,
      "end": 1630.8,
      "text": "先輩にあげます。"
    },
    {
      "start": 1630.8,
      "end": 1634.0,
      "text": "何と言いますか?"
    },
    {
      "start": 1634.0,
      "end": 1635.4,
      "text": "1"
    },
    {
      "start": 1635.4,
      "end": 1639.9,
      "text": "これ、お土産です。どうぞ。"
    },
    {
      "start": 1639.9,
      "end": 1641.1,
      "text": "2"
    },
    {
      "start": 1641.1,
      "end": 1645.08,
      "text": "お土産、いただきます。"
    },
    {
      "start": 1645.08,
      "end": 1646.48,
      "text": "3"
    },
    {
      "start": 1646.48,
      "end": 1661.78,
