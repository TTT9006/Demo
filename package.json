{
  "name": "wakaba",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"tsx watch apps/api/src/server.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && esbuild apps/api/src/server.ts --platform=node --packages=external --format=esm --bundle --outfile=dist-api/server.js && tsx scripts/ensure-full-dictionary.ts",
    "postinstall": "prisma generate",
    "start": "tsx scripts/start.ts",
    "share": "npm run build && tsx scripts/share.ts",
    "db:setup": "tsx scripts/setup.ts",
    "dictionary:download": "tsx scripts/dictionary.ts download",
    "dictionary:import": "tsx scripts/dictionary.ts import",
    "dictionary:verify": "tsx scripts/dictionary.ts verify",
    "dictionary:backfill": "tsx scripts/search-backfill.ts",
    "dictionary:benchmark": "tsx scripts/search-benchmark.ts",
    "kanji:download": "node scripts/download-kanji-data.mjs",
    "typecheck": "tsc --noEmit",
    "dictionary:translate": "tsx scripts/translate.ts",
    "dictionary:translate:common": "tsx scripts/translate.ts --only-common",
    "dictionary:translate:resume": "tsx scripts/translate.ts --resume",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:mobile": "node tests/browser/mobile-audit.mjs",
    "format": "prettier --write apps packages scripts prisma/*.ts tests *.json *.ts",
    "lint": "eslint apps packages scripts tests"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^6.19.0",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-dialog": "1.3.0",
    "@radix-ui/react-dropdown-menu": "2.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.90.21",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.3.1",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "kuromoji": "0.1.2",
    "lucide-react": "0.577.0",
    "motion": "14.1.0",
    "multer": "2.4.0",
    "node-edge-tts": "^1.2.11",
    "pdf-parse": "2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.8.0",
    "stream-json": "3.7.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "wanakana": "5.3.1",
    "zod": "4.3.6",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "25.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.1.4",
    "concurrently": "9.2.5",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "prisma": "6.19.0",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.20.0",
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0",
      "effect": "^3.20.0"
    }
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "esbuild": true
  }
}
